---
import Button from './ui/Button.astro'
---

<div class="w-full h-screen relative">
    <img src="/assets/image/home.jpg" alt="Image-Doscom" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="absolute inset-0 flex flex-col justify-between px-6 md:px-12 lg:px-50 py-26">
        <div class="mt-10 md:mt-24 lg:mt-32">
            <h1 class="text-white font-bold font-jakarta tracking-tighter leading-[0.9]
            text-[48px] sm:text-[64px] md:text-[80px] lg:text-[100px]">
                DINUS<br />OPEN<br />SOURCE<br />COMMUNITY
            </h1>
        </div>

        <div class="flex flex-col items-end gap-4 mb-6 md:mb-12 lg:mb-16">
            <p class="text-white font-normal font-jakarta leading-tight tracking-tight text-end
          text-[24px] sm:text-[32px] md:text-[40px] lg:text-[42px]">
                Open Your Mind<br />With Open Source
            </p>

            <div class="flex flex-row gap-3">
                <Button variant="primary" size="default" class="font-medium text-white text-2xl"> About </Button>
                <Button variant="outline" size="large" class="text-white font-medium text-2xl"> Contribute </Button>
            </div>
        </div>
    </div>
</div>
