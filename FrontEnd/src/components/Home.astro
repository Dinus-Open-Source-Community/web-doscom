---
import Button from "./ui/Button.astro";
---

<div class="w-full h-screen relative">
  <img
    src="/assets/image/home.jpg"
    alt="Image-Doscom"
    class="w-full h-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-black/60"></div>
  <div
    class="absolute inset-0 flex flex-col justify-between px-6 md:px-12 lg:px-20 xl:px-63 py-20 md:py-30"
  >
    <div class="mt-10 md:mt-16 lg:mt-20">
      <h1
        class="text-white font-bold font-jakarta tracking-tighter leading-[1]
            text-[36px] sm:text-[44px] md:text-[52px] lg:text-[100px]"
      >
        DINUS<br />OPEN<br />SOURCE<br />COMMUNITY
      </h1>
    </div>

    <div class="flex flex-col items-end gap-4 md:gap-5 mb-6 md:mb-10 lg:mb-12">
      <p
        class="text-white font-normal font-jakarta leading-tight tracking-tight text-end
          text-[18px] sm:text-[22px] md:text-[26px] lg:text-[42px]"
      >
        Open Your Mind<br />With open Source
      </p>

      <div class="flex flex-row gap-3 md:gap-4">
        <Button
          variant="primary"
          size="default"
          class="font-medium text-white text-sm md:text-xl"
        >
          About
        </Button>
        <Button
          variant="outline"
          size="default"
          class="text-white font-medium text-sm md:text-xl"
        >
          Contribute
        </Button>
      </div>
    </div>
  </div>
</div>
