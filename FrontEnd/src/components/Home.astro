---
import Button from './ui/Button.astro'
---

<div class="relative h-dvh w-full overflow-hidden bg-white">
  <img
    src="/assets/image/home.jpg"
    alt="Image-Doscom"
    class="absolute inset-0 z-0 h-full w-full object-cover"
    loading="lazy"
  />

  <div class="absolute inset-0 z-10 bg-black/60"></div>

  <div class="relative inset-0 z-20 flex flex-col justify-between px-6 py-12 md:px-20 md:py-20 xl:px-32 xl:py-24">
    <div class="mt-40 max-w-4xl pl-0 md:mt-25 md:pl-16">
      <h1
        class="font-jakarta text-center text-4xl leading-none font-bold tracking-tighter text-white md:text-left md:text-[100px]"
      >
        DINUS <br class="hidden md:block" /> OPEN <br class="hidden md:block" />
        SOURCE <br />COMMUNITY
      </h1>
    </div>

    <div class="mt-3 mb-4 flex flex-col items-center gap-4 md:mt-10 md:mb-10 md:items-end md:gap-6">
      <p class="font-jakarta text-right text-xl leading-none font-normal tracking-tight text-white md:text-[42px]">
        Open Your Mind<br class="hidden md:block" />With Open Source
      </p>

      <div class="flex w-3xs flex-col gap-2 md:w-full md:flex-row md:justify-end md:gap-4">
        <Button
          variant="primary"
          size="default"
          class="px-7 py-1 text-base font-medium text-white md:px-6 md:py-3 md:text-xl"
        >
          <a href="/about">About</a>
        </Button>
        <Button
          variant="outline"
          size="default"
          class="px-7 py-1 text-base font-medium text-white md:px-6 md:py-3 md:text-xl"
        >
          <a href="https://d-form.doscom.org" target="_blank">Contribute</a>
        </Button>
      </div>
    </div>
  </div>
</div>
