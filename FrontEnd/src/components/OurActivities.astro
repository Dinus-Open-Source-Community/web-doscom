---
import Button from './ui/Button.astro'
import Card from './ui/Card.astro'

interface WorkItem {
	image_url: string
	title: string
	description: string
	project_type: string
	slug: string
}

interface Props {
	items: WorkItem[]
}

const { items } = Astro.props
---

<div class="h-full w-full bg-(--color-primary)">
  <div
    class="flex h-full w-full flex-col gap-6 py-8 md:flex-row md:gap-0 md:px-12 md:py-12 lg:pl-20 xl:pl-32"
  >
    <div
      class="flex w-full flex-col justify-between space-y-6 px-4 py-3 md:w-auto md:min-w-[320px] lg:min-w-95"
    >
      <div class="space-y-4 md:space-y-6">
        <h1
          class="font-jakarta text-3xl font-semibold tracking-tight text-white md:text-4xl"
        >
          Our Recent <br class="hidden md:block" /> Activities
        </h1>
        <ul
          class="font-jakarta space-y-1 text-lg leading-relaxed font-normal tracking-tight text-white md:text-xl"
        >
          <li>Daily Activity</li>
          <li>Works</li>
          <li>Events</li>
          <li>Sharing</li>
        </ul>
      </div>
      <div class="hidden gap-2 md:flex">
        <Button id="activities-btn-left" variant="secondary" size="icon"
          ><img
            src="/assets/icons/arrowLeftPrimary.svg"
            alt="arrow left primary"
            width="24"
            height="24"
          />
        </Button>
        <Button id="activities-btn-right" variant="secondary" size="icon"
          ><img
            src="/assets/icons/arrowRightPrimary.svg"
            alt="arrow right primary"
            width="24"
            height="24"
          /></Button
        >
      </div>
    </div>

    <div
      id="activities-carousel"
      class="no-scrollbar relative flex w-full snap-x gap-4 overflow-visible overflow-x-auto scroll-smooth py-3 md:gap-6"
    >
      {items.map((item) => (
        <Card
          image={item.image_url}
          variant="activities"
          title={item.title}
          desc={item.description}
          category={[item.project_type]}
        />
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('activities-carousel')
    const btnLeft = document.getElementById('activities-btn-left')
    const btnRight = document.getElementById('activities-btn-right')

    if (btnLeft && btnRight && carousel) {
      btnLeft.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' })
      })

      btnRight.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: cardWidth + gap, behavior: 'smooth' })
      })
    }
  })
</script>
