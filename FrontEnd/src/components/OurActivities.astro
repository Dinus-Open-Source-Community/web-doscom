---
import Button from './ui/Button.astro'
import Card from './ui/Card.astro'
---

<div class="h-full w-full bg-(--color-primary)">
  <div
    class="flex h-full w-full flex-col gap-6 py-8 md:flex-row md:gap-0 md:px-12 md:py-12 lg:pl-20 xl:pl-32"
  >
    <div
      class="flex w-full flex-col justify-between space-y-6 px-4 py-3 md:w-auto md:min-w-[320px] lg:min-w-95"
    >
      <div class="space-y-4 md:space-y-6">
        <h1
          class="font-jakarta text-3xl font-semibold tracking-tight text-white md:text-4xl"
        >
          Our Recent <br class="hidden md:block" /> Activities
        </h1>
        <ul
          class="font-jakarta space-y-1 text-lg leading-relaxed font-normal tracking-tight text-white md:text-xl"
        >
          <li>Daily Activity</li>
          <li>Works</li>
          <li>Events</li>
          <li>Sharing</li>
        </ul>
      </div>
      <div class="hidden gap-2 md:flex">
        <Button variant="secondary" size="icon"
          ><img
            src="/assets/icons/arrowLeftPrimary.svg"
            alt="arrow left primary"
            width="24"
            height="24"
          />
        </Button>
        <Button variant="secondary" size="icon"
          ><img
            src="/assets/icons/arrowRightPrimary.svg"
            alt="arrow right primary"
            width="24"
            height="24"
          /></Button
        >
      </div>
    </div>

    <div
      class="no-scrollbar relative flex w-full snap-x gap-4 overflow-visible overflow-x-auto scroll-smooth py-3 md:gap-6"
    >
      <Card
        image="/assets/image/realeaseParty.jpg"
        variant="activities"
        title="TealinuxOS"
        desc="Release Party adalah acara peluncuran TeaLinuxOS, distro Linux racikan DOSCOM yang dikembangkan secara terbuka dengan filosofi “Nikmatnya Sebuah Racikan”."
        category={['Workshop', 'Bootcamp']}
      />
      <Card
        image="/assets/image/du.jpg"
        variant="activities"
        title="Doscom University"
        desc="Doscom University bukanlah universitas fisik, melainkan sebuah program atau acara pelatihan yang diselenggarakan oleh Doscom (Dinus Open Source Community). "
        category={['Workshop', 'Bootcamp']}
      />
      <Card
        image="/assets/image/tealinux.png"
        variant="activities"
        title="Rice Source"
        desc="An open-source repository for community projects and experiments"
        category={['Workshop', 'Bootcamp']}
      />
    </div>
  </div>
</div>
