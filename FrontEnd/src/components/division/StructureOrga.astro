---
import Card from '../ui/Card.astro'
---

<div class="w-full full px-6 sm:px-10 lg:px-16 xl:px-30 my-15">
    <div class="flex flex-col lg:flex-row gap-12 justify-center items-center lg:gap-13">
        <div class="flex flex-col gap-2.5">
            <div class="flex gap-2.5">
                <Card variant="structure-orga" title="Public Relations" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="BPH" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                <Card variant="structure-orga" title="Pemrograman" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="Data" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="Jaringan" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="Media Creative" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="Humas" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
                <Card variant="structure-orga" title="Sdm" desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi." />
            </div>
        </div>

        <div class="font-jakarta lg:max-w-[460px]">
            <h1 class="font-bold text-[32px] sm:text-[38px] lg:text-[42px] w-[314px] leading-tight">Different Skills, One Vision.</h1>
            <p class="mt-3 text-base sm:text-lg leading-relaxed tracking-tight w-[463px] text-[#6C6C6C] font-medium">
                Beragam divisi di DOSCOM bersatu dengan satu tujuan: menyebarkan semangat open source. Kami datang dari latar belakang dan keahlian yang berbeda – dari pemrograman,
                desain, hingga riset – namun bergerak bersama untuk belajar, berbagi, dan menciptakan inovasi yang berdampak bagi komunitas dan dunia teknologi.
            </p>
        </div>
    </div>
</div>
