---
import { Search } from "../../../assets/icons";
---

<button id="trigger-search-modal" class="relative w-80 group text-left focus:outline-none shrink-0">
  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
    <span
      class="w-4 h-4 text-gray-400 group-hover:text-cyan-500 transition-colors [&>svg]:w-full [&>svg]:h-full"
      set:html={Search}
    />
  </div>

  <div
    class="block w-full pl-10 pr-12 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-gray-400 group-hover:border-cyan-400 group-hover:ring-4 group-hover:ring-cyan-500/10 transition-all duration-300 shadow-sm"
  >
    Quick search...
  </div>

  <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
    <span
      class="text-[10px] font-bold text-gray-400 border border-gray-200 rounded px-1.5 py-0.5 bg-gray-50 uppercase tracking-widest group-hover:border-cyan-200 group-hover:text-cyan-500 transition-colors"
    >
      Ctrl K
    </span>
  </div>
</button>
