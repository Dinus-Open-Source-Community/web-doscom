---
import ButtonAdmin from '../ButtonAdmin.astro'
import { Close } from '../../../assets/icons'
---

<dialog
  id="delete-coreteam-modal"
  class="m-auto w-full max-w-sm rounded-2xl border border-gray-100 bg-white p-6 shadow-xl transition-all backdrop:bg-gray-900/50 open:flex open:flex-col open:gap-5"
>
  <div class="flex items-start justify-between">
    <div class="flex flex-col gap-1.5">
      <div
        class="mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-rose-100 text-rose-600"
      >
        {/* Ikon Warning / Alert bawaan khusus untuk modal ini */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
          ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
            x1="12"
            y1="17"
            x2="12.01"
            y2="17"></line></svg
        >
      </div>
      <h2 class="text-lg font-bold text-gray-900">Delete Member?</h2>
      <p class="text-sm text-gray-500">
        Are you sure you want to delete this member? This action cannot be
        undone and will permanently remove their data from the server.
      </p>
    </div>
    <button
      type="button"
      id="btn-close-delete-coreteam-modal"
      class="self-start rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900"
    >
      <span
        class="flex h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full"
        set:html={Close}
      />
    </button>
  </div>

  <form id="form-delete-coreteam" class="flex flex-col gap-0">
    {/* Hidden Input untuk menampung ID target yang akan dihapus */}
    <input type="hidden" name="delete_target_id" id="delete_target_id" />

    <div
      class="mt-4 flex w-full items-center justify-end gap-3 border-t border-gray-100 pt-5"
    >
      <ButtonAdmin
        type="button"
        variant="admin-outline"
        id="btn-cancel-delete-coreteam-modal"
        class="w-full sm:w-auto"
      >
        Cancel
      </ButtonAdmin>
      <button
        type="submit"
        class="w-full rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white transition-all hover:bg-rose-700 focus:ring-2 focus:ring-rose-600 focus:ring-offset-2 focus:outline-none sm:w-auto"
      >
        Yes, Delete
      </button>
    </div>
  </form>
</dialog>

<script>
  const deleteModal = document.getElementById(
    'delete-coreteam-modal'
  ) as HTMLDialogElement
  const btnCloseDelete = document.getElementById(
    'btn-close-delete-coreteam-modal'
  )
  const btnCancelDelete = document.getElementById(
    'btn-cancel-delete-coreteam-modal'
  )
  const deleteForm = document.getElementById(
    'form-delete-coreteam'
  ) as HTMLFormElement
  const deleteTargetIdInput = document.getElementById(
    'delete_target_id'
  ) as HTMLInputElement

  // Fungsi Global untuk membuka Modal Delete
  ;(window as any).openDeleteCoreTeamModal = (userId: string) => {
    if (!userId) return

    // Simpan ID ke hidden input
    deleteTargetIdInput.value = userId

    // Tampilkan modal
    deleteModal?.showModal()
  }

  const closeDeleteModal = () => {
    deleteModal?.close()
    deleteTargetIdInput.value = ''
  }

  if (btnCloseDelete) btnCloseDelete.addEventListener('click', closeDeleteModal)
  if (btnCancelDelete)
    btnCancelDelete.addEventListener('click', closeDeleteModal)

  // Klik di luar modal untuk menutup
  deleteModal?.addEventListener('click', e => {
    const rect = deleteModal.getBoundingClientRect()
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      closeDeleteModal()
    }
  })

  // Handle Submit Form (DELETE)
  if (deleteForm) {
    deleteForm.addEventListener('submit', async e => {
      e.preventDefault()

      const submitBtn = deleteForm.querySelector(
        'button[type="submit"]'
      ) as HTMLButtonElement
      const originalText = submitBtn.innerText
      submitBtn.innerText = 'Deleting...'
      submitBtn.disabled = true

      const targetId = deleteTargetIdInput.value

      try {
        // Eksekusi DELETE request
        const response = await fetch(
          `https://api.doscom.id/v1/core-team/${targetId}`,
          {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
          }
        )

        const result = await response.json()

        if (response.status === 200 && result.success) {
          closeDeleteModal()
          ;(window as any).showToast(
            'Pengurus deleted successfully!',
            'success'
          )

          // Hapus baris dari tabel secara dinamis tanpa reload halaman (opsional tapi bikin UI terasa cepat)
          // const rowToHide = document.querySelector(`tr:has(button[onclick*="${targetId}"])`);
          // if (rowToHide) rowToHide.remove();

          // Atau gunakan reload tradisional:
          // setTimeout(() => window.location.reload(), 1000);
        } else {
          ;(window as any).showToast(
            result.message || 'Failed to delete data',
            'error'
          )
        }
      } catch (error) {
        console.error('Network Error:', error)
        ;(window as any).showToast('Network error, please try again.', 'error')
      } finally {
        submitBtn.innerText = originalText
        submitBtn.disabled = false
      }
    })
  }
</script>
