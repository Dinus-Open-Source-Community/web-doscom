---
import ButtonAdmin from '../ButtonAdmin.astro';
import { Close } from '../../../assets/icons';
---

<dialog
  id="add-admin-modal"
  class="m-auto w-full max-w-md rounded-2xl border border-gray-100 bg-white p-6 shadow-xl backdrop:bg-gray-900/50 transition-all open:flex open:flex-col open:gap-6"
>
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-bold text-gray-900">Add Super Admin</h2>
    <button type="button" id="btn-close-modal" class="rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
      <span class="flex h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Close} />
    </button>
  </div>

  <form id="form-add-admin" class="flex flex-col gap-4">
    <div class="flex flex-col gap-1.5">
      <label for="fullname" class="text-sm font-medium text-gray-700">Full Name</label>
      <input
        type="text"
        name="fullname"
        id="fullname"
        required
        placeholder="e.g., Super Admin Baru"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm outline-none transition-all focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="email" class="text-sm font-medium text-gray-700">Email Address</label>
      <input
        type="email"
        name="email"
        id="email"
        required
        placeholder="e.g., super@doscom.id"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm outline-none transition-all focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="password" class="text-sm font-medium text-gray-700">Password</label>
      <input
        type="password"
        name="password"
        id="password"
        required
        minlength="8"
        placeholder="••••••••"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm outline-none transition-all focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
    </div>

    <div class="mt-2 flex w-full items-center justify-end gap-3">
      <ButtonAdmin type="button" variant="admin-outline" id="btn-cancel-modal" class="w-full sm:w-auto">
        Cancel
      </ButtonAdmin>
      <ButtonAdmin type="submit" variant="admin-primary" class="w-full sm:w-auto">
        Create Admin
      </ButtonAdmin>
    </div>
  </form>
</dialog>

<script>
  const modal = document.getElementById('add-admin-modal') as HTMLDialogElement;
  const btnOpen = document.getElementById('btn-open-add-admin');
  const btnClose = document.getElementById('btn-close-modal');
  const btnCancel = document.getElementById('btn-cancel-modal');
  const form = document.getElementById('form-add-admin') as HTMLFormElement;

  // Buka Modal
  if (btnOpen && modal) {
    btnOpen.addEventListener('click', () => {
      modal.showModal();
    });
  }

  // Tutup Modal
  const closeModal = () => {
    modal.close();
    form.reset(); // Bersihkan form saat ditutup
  };

  if (btnClose) btnClose.addEventListener('click', closeModal);
  if (btnCancel) btnCancel.addEventListener('click', closeModal);

  // Klik di luar area modal untuk menutup
  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      closeModal();
    }
  });

  // Handle Submit Form (POST API)
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Ubah button menjadi loading state (opsional)
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerText;
      submitBtn.innerText = 'Creating...';
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        // TODO: Ganti URL dengan endpoint API backend yang asli
        const response = await fetch('https://api.doscom.id/v1/superadmin', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            // 'Authorization': `Bearer ${localStorage.getItem('token')}` // Buka jika butuh token
          },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (response.status === 201 && result.success) {
          alert('Berhasil: ' + result.message);
          closeModal();
          window.location.reload(); // Refresh halaman untuk update tabel
        } else {
          alert('Gagal: ' + (result.message || 'Terjadi kesalahan'));
        }
      } catch (error) {
        console.error('Network Error:', error);
        alert('Gagal menghubungi server.');
      } finally {
        // Kembalikan state button
        submitBtn.innerText = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>