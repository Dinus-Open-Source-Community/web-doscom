---
interface Props {
  title: string;
  value: string | number;
  icon: string;
  colorGradient: string;
  colorBg: string;
  colorText: string;
}

const { title, value, icon, colorGradient, colorBg, colorText } = Astro.props;
---

<div
  class={`flex gap-4 md:gap-5 items-center justify-start border border-gray-100 rounded-xl px-5 py-4 md:px-7 md:py-5 bg-gradient-to-tl ${colorGradient} to-40% shadow-sm transition-all`}
>
  <div class={`${colorBg} p-2.5 md:p-3 rounded-full shrink-0`}>
    <span class={`${colorText} [&>svg]:h-6 [&>svg]:w-6 md:[&>svg]:h-8 md:[&>svg]:w-8`} set:html={icon} />
  </div>

  <div class="flex flex-col min-w-0">
    <p class="text-2xl md:text-3xl font-extrabold text-gray-800 truncate">{value}</p>
    <p class="text-gray-500 font-semibold text-xs md:text-sm truncate">{title}</p>
  </div>
</div>
