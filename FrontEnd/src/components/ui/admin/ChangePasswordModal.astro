---
import ButtonAdmin from "../ButtonAdmin.astro";
import { Close } from "../../../assets/icons";
---

<dialog
  id="change-password-modal"
  class="m-auto w-full max-w-sm rounded-2xl border border-gray-100 bg-white p-6 shadow-xl backdrop:bg-gray-900/50 transition-all open:flex open:flex-col open:gap-6"
>
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-bold text-gray-900">Change Password</h2>
    <button type="button" id="btn-close-cp-modal" class="rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
      <span class="flex h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Close} />
    </button>
  </div>

  <form id="form-change-password" class="flex flex-col gap-4">
    {/* Input tersembunyi untuk menyimpan ID user target */}
    <input type="hidden" id="target-user-id" name="target_user_id" />

    <div class="flex flex-col gap-1.5">
      <label for="new_password" class="text-sm font-medium text-gray-700">New Password</label>
      <input
        type="password"
        name="new_password"
        id="new_password"
        required
        minlength="8"
        placeholder="Enter new password"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm outline-none transition-all focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
    </div>

    <div class="mt-2 flex w-full items-center justify-end gap-3">
      <ButtonAdmin type="button" variant="admin-outline" id="btn-cancel-cp-modal" class="w-full sm:w-auto">
        Cancel
      </ButtonAdmin>
      <ButtonAdmin type="submit" variant="admin-primary" class="w-full sm:w-auto">
        Save Changes
      </ButtonAdmin>
    </div>
  </form>
</dialog>

<script>
  const cpModal = document.getElementById('change-password-modal') as HTMLDialogElement;
  const btnCloseCp = document.getElementById('btn-close-cp-modal');
  const btnCancelCp = document.getElementById('btn-cancel-cp-modal');
  const cpForm = document.getElementById('form-change-password') as HTMLFormElement;
  const targetUserIdInput = document.getElementById('target-user-id') as HTMLInputElement;

  // Fungsi global untuk membuka modal ini dari tombol di tabel
  (window as any).openChangePasswordModal = (userId: string) => {
    targetUserIdInput.value = userId;
    cpModal?.showModal();
  };

  const closeCpModal = () => {
    cpModal?.close();
    cpForm?.reset();
  };

  if (btnCloseCp) btnCloseCp.addEventListener('click', closeCpModal);
  if (btnCancelCp) btnCancelCp.addEventListener('click', closeCpModal);

  // Klik luar area untuk tutup
  cpModal?.addEventListener('click', (e) => {
    const rect = cpModal.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
      closeCpModal();
    }
  });

  // Handle Eksekusi PUT
  if (cpForm) {
    cpForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = cpForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.innerText;
      submitBtn.innerText = 'Saving...';
      submitBtn.disabled = true;

      const userId = targetUserIdInput.value;
      const newPassword = (document.getElementById('new_password') as HTMLInputElement).value;

      try {
        // Eksekusi PUT request
        const response = await fetch(`https://api.doscom.id/v1/users/${userId}/password`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ new_password: newPassword })
        });

        const result = await response.json();

        if (response.status === 200 && result.success) {
          closeCpModal();
          // Panggil Toast Success dari file Toast.astro
          (window as any).showToast('Password changed successfully!', 'success');
        } else {
          // Panggil Toast Error
          (window as any).showToast(result.message || 'Failed to change password', 'error');
        }
      } catch (error) {
        console.error('Network Error:', error);
        (window as any).showToast('Network error, please try again.', 'error');
      } finally {
        submitBtn.innerText = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>