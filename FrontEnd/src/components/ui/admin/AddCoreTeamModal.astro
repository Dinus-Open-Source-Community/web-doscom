---
import ButtonAdmin from '../ButtonAdmin.astro'
import { Close } from '../../../assets/icons'
---

<dialog
  id="add-coreteam-modal"
  class="m-auto w-full max-w-2xl rounded-2xl border border-gray-100 bg-white p-6 shadow-xl transition-all backdrop:bg-gray-900/50 open:flex open:flex-col open:gap-6"
>
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Add Core Team</h2>
      <p class="mt-1 text-xs text-gray-400">
        Add a new administrator to the division
      </p>
    </div>
    <button
      type="button"
      id="btn-close-coreteam-modal"
      class="self-start rounded-lg p-1.5 text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900"
    >
      <span
        class="flex h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full"
        set:html={Close}
      />
    </button>
  </div>

  <form
    id="form-add-coreteam"
    class="flex flex-col gap-6"
    enctype="multipart/form-data"
  >
    {
      /* Hidden Input untuk menampung id_user jika yang ditambahkan adalah user existing */
    }
    <input type="hidden" name="id_user" id="id_user" />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {/* Name Input */}
      <div class="flex flex-col gap-1.5">
        <label for="name" class="text-sm font-medium text-gray-700">
          Full Name <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          name="name"
          id="name"
          required
          placeholder="e.g., Husnul Fikri Averus"
          class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
        />
      </div>

      {/* Email Input */}
      <div class="flex flex-col gap-1.5">
        <label for="email" class="text-sm font-medium text-gray-700">
          Email Address
        </label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="Leave blank if user exists"
          class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
        />
      </div>

      {/* Divisi Input */}
      <div class="flex flex-col gap-1.5">
        <label for="divisi" class="text-sm font-medium text-gray-700">
          Division <span class="text-rose-500">*</span>
        </label>
        <select
          name="divisi"
          id="divisi"
          required
          class="w-full cursor-pointer rounded-xl border border-gray-200 bg-gray-50/50 py-2.5 pr-10 pl-4 text-sm text-gray-900 transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
        >
          <option value="" disabled selected>Select Division</option>
          <option value="Programming">Programming</option>
          <option value="Multimedia">Multimedia</option>
          <option value="Networking">Networking</option>
          <option value="Public Relation">Public Relation</option>
        </select>
      </div>

      {/* Position Input */}
      <div class="flex flex-col gap-1.5">
        <label for="position" class="text-sm font-medium text-gray-700">
          Position <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          name="position"
          id="position"
          required
          placeholder="e.g., Coordinator"
          class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
        />
      </div>

      {/* Periode Input (Start & End) */}
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-medium text-gray-700">
          Active Period <span class="text-rose-500">*</span>
        </label>
        <div class="flex items-center gap-2">
          <input
            type="number"
            name="start_periode_year"
            placeholder="Start"
            required
            value="2026"
            min="2010"
            class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
          />
          <span class="text-gray-400">-</span>
          <input
            type="number"
            name="end_periode_year"
            placeholder="End"
            required
            value="2027"
            min="2010"
            class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
          />
        </div>
      </div>

      {/* Social Media Input */}
      <div class="flex flex-col gap-1.5">
        <label for="sosmed_input" class="text-sm font-medium text-gray-700">
          Social Media Links
        </label>
        <input
          type="text"
          id="sosmed_input"
          placeholder="Separate with commas (e.g., ig.com/a, x.com/b)"
          class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
        />
        <p class="text-[10px] text-gray-400">
          Optional. Array data will be generated automatically.
        </p>
      </div>
    </div>

    {/* File / Avatar Upload */}
    <div class="flex flex-col gap-1.5">
      <label for="file" class="text-sm font-medium text-gray-700">
        Profile Photo
      </label>
      <input
        type="file"
        name="file"
        id="file"
        accept="image/png, image/jpeg, image/webp"
        class="w-full cursor-pointer rounded-xl border border-dashed border-gray-300 bg-gray-50/30 px-4 py-2.5 text-sm text-gray-500 transition-all file:mr-4 file:cursor-pointer file:rounded-md file:border-0 file:bg-gray-900 file:px-4 file:py-2 file:text-xs file:font-semibold file:text-white hover:border-gray-400 focus:outline-none"
      />
    </div>

    <div
      class="mt-2 flex w-full items-center justify-end gap-3 border-t border-gray-100 pt-6"
    >
      <ButtonAdmin
        type="button"
        variant="admin-outline"
        id="btn-cancel-coreteam-modal"
        class="w-full sm:w-auto"
      >
        Cancel
      </ButtonAdmin>
      <ButtonAdmin
        type="submit"
        variant="admin-primary"
        class="w-full sm:w-auto"
      >
        Save Member
      </ButtonAdmin>
    </div>
  </form>
</dialog>

<script>
  const ctModal = document.getElementById(
    'add-coreteam-modal'
  ) as HTMLDialogElement
  const btnOpenCt = document.getElementById('btn-open-add-coreteam')
  const btnCloseCt = document.getElementById('btn-close-coreteam-modal')
  const btnCancelCt = document.getElementById('btn-cancel-coreteam-modal')
  const ctForm = document.getElementById('form-add-coreteam') as HTMLFormElement

  // 1. Buka lewat ID tombol statis (Lebih disarankan)
  if (btnOpenCt) {
    btnOpenCt.addEventListener('click', () => {
      ctModal?.showModal()
    })
  }

  // 2. Opsi Buka lewat Global Function (Bisa menampung parameter ID user existing)
  ;(window as any).openAddCoreTeamModal = (userId?: string) => {
    const idInput = document.getElementById('id_user') as HTMLInputElement
    if (idInput) {
      idInput.value = userId || '' // Isi hidden input jika ID diberikan
    }
    ctModal?.showModal()
  }

  const closeCtModal = () => {
    ctModal?.close()
    ctForm?.reset()

    // Pastikan hidden input juga ikut kosong saat ditutup
    const idInput = document.getElementById('id_user') as HTMLInputElement
    if (idInput) idInput.value = ''
  }

  if (btnCloseCt) btnCloseCt.addEventListener('click', closeCtModal)
  if (btnCancelCt) btnCancelCt.addEventListener('click', closeCtModal)

  // Klik di luar modal untuk menutup
  ctModal?.addEventListener('click', e => {
    const rect = ctModal.getBoundingClientRect()
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      closeCtModal()
    }
  })

  // Handle Submit Form
  if (ctForm) {
    ctForm.addEventListener('submit', async e => {
      e.preventDefault()

      const submitBtn = ctForm.querySelector(
        'button[type="submit"]'
      ) as HTMLButtonElement
      const originalText = submitBtn.innerText
      submitBtn.innerText = 'Saving...'
      submitBtn.disabled = true

      try {
        const formData = new FormData(ctForm)

        // Hapus field id_user dari formData jika kosong (menandakan user baru)
        if (!formData.get('id_user')) {
          formData.delete('id_user')
        }

        // Parsing manual input string sosmed (koma) menjadi format array untuk FormData
        const sosmedRaw = (
          document.getElementById('sosmed_input') as HTMLInputElement
        ).value
        if (sosmedRaw) {
          const sosmedArray = sosmedRaw
            .split(',')
            .map(s => s.trim())
            .filter(s => s !== '')
          sosmedArray.forEach(item => {
            formData.append('sosmed[]', item)
          })
        }

        // Eksekusi POST request (multipart/form-data otomatis)
        const response = await fetch(`https://api.doscom.id/v1/core-team`, {
          method: 'POST',
          body: formData,
        })

        const result = await response.json()

        if (response.status === 201 && result.success) {
          closeCtModal()
          ;(window as any).showToast('Core Team added successfully!', 'success')
        } else {
          ;(window as any).showToast(
            result.message || 'Failed to add member',
            'error'
          )
        }
      } catch (error) {
        console.error('Network Error:', error)
        ;(window as any).showToast('Network error, please try again.', 'error')
      } finally {
        submitBtn.innerText = originalText
        submitBtn.disabled = false
      }
    })
  }
</script>
