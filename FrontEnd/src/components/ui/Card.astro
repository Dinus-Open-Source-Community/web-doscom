---
import Button from './Button.astro'
import arrowIcon from '../../assets/icon-arrow.svg?raw'

interface Card {
  variant: 'programs' | 'core-team' | 'works' | 'activities' | 'structure-orga' | 'projects' | 'blogs'
  category: string[] | string
  tags?: string[]
}

const { variant = 'programs', image, title, desc, titleButton, category, tags = [], index = 0 } = Astro.props
---

{
  variant === 'programs' && (
    <div class="relative h-[380px] w-full shrink-0 overflow-hidden rounded-2xl shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition sm:h-[420px] md:h-[460px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />

      <div class="absolute inset-0 bg-linear-to-t from-black via-black/55 to-transparent" />

      <div class="absolute bottom-0 p-4 text-white sm:p-5">
        <h2 class="font-poppins text-lg font-semibold sm:text-xl md:text-2xl">{title}</h2>
        <p class="font-poppins text-xs font-normal tracking-tight opacity-90 sm:text-sm">{desc}</p>

        <Button
          variant="primary"
          size="full"
          class="font-poppins mt-3 rounded-xl p-2.5 text-xs font-semibold text-white sm:text-sm md:text-base"
        >
          {titleButton}
        </Button>
      </div>
    </div>
  )
}

{
  variant === 'core-team' && (
    <div class="flex h-full w-full flex-col gap-3 rounded-xl bg-[#0a84dc] px-4 pt-4 pb-7">
      <img src={image} alt={title} class="rounded-lg" />
      <div class="flex flex-col gap-1 text-white">
        <p class="text-3xl font-bold">{title}</p>
        <p class="text-sm">{desc}</p>
      </div>
    </div>
  )
}

{
  variant === 'works' && (
    <div class="relative h-[420px] w-[340px] shrink-0 overflow-hidden rounded-2xl bg-black shadow-[4px_6px_14px_rgba(0,0,0,0.25)] transition sm:h-[500px] sm:w-[420px] md:h-[560px] md:w-[580px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />

      <div class="absolute inset-0 bg-black/55" />

      <div class="font-jakarta absolute bottom-0 flex flex-col gap-2 p-5 text-white sm:p-7 md:p-9">
        <div class="w-fit rounded-full bg-white px-3 py-1.5 text-xs font-medium tracking-tight text-black sm:text-sm">
          <span>{category}</span>
        </div>

        <h2 class="text-2xl leading-tight font-semibold tracking-tight sm:text-[28px] md:text-[32px]">{title}</h2>
        <p class="text-sm font-normal opacity-85 sm:text-base">{desc}</p>
      </div>
    </div>
  )
}

{
  variant === 'works' && (
    <div class="relative h-[420px] w-[340px] shrink-0 overflow-hidden rounded-2xl bg-black shadow-[4px_6px_14px_rgba(0,0,0,0.25)] transition sm:h-[500px] sm:w-[420px] md:h-[560px] md:w-[580px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />

        {category.length > 0 && (
          <div class="flex gap-2">
            {category.map((cat: string) => (
              <div class="w-fit rounded-full bg-(--color-primary) px-5 py-2.5 text-sm font-medium tracking-tight text-white sm:text-base">
                <span>{cat}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

{
  variant === 'structure-orga' && (
    <div class="relative min-h-[157px] w-[174px] rounded-lg bg-linear-to-br from-(--color-primary)/80 to-white p-0.5 shadow-xl">
