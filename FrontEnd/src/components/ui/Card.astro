---
import Button from './Button.astro'

interface Card {
    variant: 'programs' | 'works'
}

const { variant = 'programs', image, title, desc, titleButton, category } = Astro.props
---

{
    variant === 'programs' && (
        <div class="relative w-full h-[420px] md:h-[460px] rounded-2xl overflow-hidden shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition">
            <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent" />
            <div class="absolute bottom-0 p-5 text-white">
                <h2 class="text-xl md:text-2xl font-poppins font-semibold">{title}</h2>

                <p class="font-poppins font-normal text-sm opacity-90 tracking-tight">{desc}</p>

                <Button variant="primary" size="full" class="mt-3 text-white font-semibold text-sm md:text-base font-poppins p-2.5 rounded-xl">
                    {titleButton}
                </Button>
            </div>
        </div>
    )
}

{
    variant === 'works' && (
        <div class="relative w-[580px] h-[560px] rounded-2xl overflow-hidden shadow-[4px_6px_14px_rgba(0,0,0,0.25)] bg-black transition shrink-0">
            <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />

            <div class="absolute inset-0 bg-black/55 to-transparent" />

            <div class="absolute bottom-0 p-9 text-white font-jakarta flex flex-col gap-2">
                <div class="bg-white text-black w-fit px-3 py-1.5 rounded-full font-medium text-sm tracking-tight">
                    <span>{category}</span>
                </div>

                <h2 class="text-[32px] leading-tight tracking-tight font-semibold">{title}</h2>

                <p class="text-base opacity-85 font-normal">{desc}</p>
            </div>
        </div>
    )
}
