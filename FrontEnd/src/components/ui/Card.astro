---
import Button from './Button.astro'

interface Card {
  variant: 'programs' | 'works' | 'activities' | 'structure-orga'
  category: string[] | string
}

const { variant = 'programs', image, title, desc, titleButton, category } = Astro.props
---

{
  variant === 'programs' && (
    <div class="relative h-[380px] w-full shrink-0 overflow-hidden rounded-2xl shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition sm:h-[420px] md:h-[460px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/55 to-transparent" />
      <div class="absolute bottom-0 p-5 text-white">
        <h2 class="font-poppins text-xl font-semibold md:text-2xl">{title}</h2>

      <div class="absolute inset-0 bg-linear-to-t from-black via-black/55 to-transparent" />

      <div class="absolute bottom-0 p-4 text-white sm:p-5">
        <h2 class="font-poppins text-lg font-semibold sm:text-xl md:text-2xl">{title}</h2>
        <p class="font-poppins text-xs font-normal tracking-tight opacity-90 sm:text-sm">{desc}</p>

        <Button
          variant="primary"
          size="full"
          class="font-poppins mt-3 rounded-xl p-2.5 text-sm font-semibold text-white md:text-base"
        >
          {titleButton}
        </Button>
      </div>
    </div>
  )
}

{
  variant === 'works' && (
    <div class="relative h-[420px] w-[340px] shrink-0 overflow-hidden rounded-2xl bg-black shadow-[4px_6px_14px_rgba(0,0,0,0.25)] transition sm:h-[500px] sm:w-[420px] md:h-[560px] md:w-[580px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />

      <div class="absolute inset-0 bg-black/55 to-transparent" />

      <div class="font-jakarta absolute bottom-0 flex flex-col gap-2 p-9 text-white">
        <div class="w-fit rounded-full bg-white px-3 py-1.5 text-sm font-medium tracking-tight text-black">
          <span>{category}</span>
        </div>

        <h2 class="text-[32px] leading-tight font-semibold tracking-tight">{title}</h2>

        <p class="text-base font-normal opacity-85">{desc}</p>
      </div>
    </div>
  )
}

{
  variant === 'activities' && (
    <div class="relative flex h-[500px] w-[360px] shrink-0 flex-col justify-between overflow-hidden rounded-3xl bg-white p-3.5 transition sm:h-[540px] sm:w-[520px] md:h-[575px] md:w-[656px]">
      <img
        src={image}
        alt={title}
        class="h-[260px] w-full rounded-xl object-cover sm:h-80 md:h-[359px]"
        loading="lazy"
      />

      <div class="font-jakarta mt-2 flex flex-col gap-2 text-(--text-secondary)">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-[28px] md:text-[32px]">{title}</h2>
        <p class="mb-2 w-[541.7px] text-start text-sm font-normal tracking-normal opacity-85 sm:text-base">{desc}</p>

        {category.length > 0 && (
          <div class="flex gap-2">
            {category.map((cat: string) => (
              <div class="w-fit rounded-full bg-(--color-primary) px-5 py-2.5 text-sm font-medium tracking-tight text-white sm:text-base">
                <span>{cat}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

{
  variant === 'structure-orga' && (
    <div class="relative min-h-[157px] w-[174px] rounded-lg bg-linear-to-br from-(--color-primary)/80 to-white p-0.5 shadow-xl">
      <div class="h-full w-full rounded-lg bg-white px-3 py-6">
        <div class="flex h-full flex-col">
          <div class="mb-3 w-fit rounded-full bg-(--color-primary) p-1.5">
            <img src="/assets/icons/horn.svg" alt="" class="h-5 w-5 sm:h-7 sm:w-7" />
          </div>

            <div class="text-[var(--text-secondary)] font-jakarta flex flex-col gap-2 mt-2">
                <h2 class="text-2xl sm:text-[28px] md:text-[32px] tracking-tight font-semibold">{title}</h2>
                <p class="text-sm sm:text-base opacity-85 font-normal tracking-normal w-[541.7px] text-start mb-2">{desc}</p>

                {category.length > 0 && (
                    <div class=" flex gap-2">
                        {category.map((cat: string) => (
                            <div class="bg-[var(--color-primary)] text-white w-fit px-5 py-2.5 rounded-full font-medium text-sm sm:text-base tracking-tight">
                                <span>{cat}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    )
}

{
  variant === 'division' && (
    <div class="relative h-[300px] w-full sm:h-[380px] md:h-[580px]">
      <img src={image} alt={title} class="h-full w-full object-cover" />

      <div class="absolute inset-0 bg-linear-to-t from-(--color-primary) via-[var(--color-primary)/45] to-transparent" />

      <div class="absolute inset-0 mx-auto flex w-full max-w-[80%] items-end justify-between px-4 pb-6 sm:px-8 sm:pb-8 md:pb-10">
        <h1 class="font-jakarta block w-[386px] text-xl leading-[1.05] font-bold wrap-break-word text-white uppercase drop-shadow-xl sm:text-3xl md:text-[40px]">
          {title}
        </h1>

        <Button
          variant="primary"
          size="default"
          class="font-poppins text-sm font-medium text-white shadow-md shadow-white/50 transition hover:shadow-none sm:text-base md:text-lg lg:text-xl"
        >
            <div class="rounded-lg py-6 px-3 bg-white w-full h-full">
                <div class=" flex flex-col h-full">
                    <div class="rounded-full bg-[var(--color-primary)] p-1.5 w-fit mb-3">
                        <img src="/assets/icons/horn.svg" alt="" class="w-5 h-5 sm:w-7 sm:h-7" />
                    </div>

{
  variant === 'structure-orga' && (
    <div class="relative min-h-[157px] w-[174px] rounded-lg bg-linear-to-br from-(--color-primary)/80 to-white p-0.5 shadow-xl">
      <div class="h-full w-full rounded-lg bg-white px-3 py-6">
        <div class="flex h-full flex-col">
          <div class="mb-3 w-fit rounded-full bg-(--color-primary) p-1.5">
            <img src="/assets/icons/horn.svg" alt="" class="h-5 w-5 sm:h-7 sm:w-7" />
          </div>

          <div class="mt-auto">
            <h2 class="font-jakarta text-[14px] font-semibold sm:text-[16px]">{title}</h2>
            <p class="font-jakarta text-[10px] font-normal tracking-wide sm:text-[12px]">{desc}</p>
          </div>
        </div>
    )
}

{
    variant === 'division' && (
        <div class="relative w-full h-[300px] sm:h-[380px] md:h-[580px]">
            <img src={image} alt={title} class="w-full h-full object-cover " />

            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-primary)] via-[var(--color-primary)/45] to-transparent" />

            <div class="absolute inset-0 w-full max-w-[80%] mx-auto flex items-end justify-between px-4 sm:px-8  pb-6 sm:pb-8 md:pb-10">
                <h1 class="font-jakarta font-bold uppercase text-white text-xl sm:text-3xl md:text-[40px] w-[386px] drop-shadow-xl block break-words leading-[1.05]">{title}</h1>

                <Button
                    variant="primary"
                    size="default"
                    class="text-sm sm:text-base md:text-lg lg:text-xl text-white font-poppins font-medium hover:shadow-none transition  shadow-md shadow-white/50"
                >
                    Read More
                </Button>
            </div>
        </div>

        <h2 class="text-[32px] leading-tight font-semibold tracking-tight">{title}</h2>

        <p class="text-base font-normal opacity-85">{desc}</p>
    )
      </div>
    </div>
  )
}

{
  variant === 'division' && (
    <div class="relative h-[300px] w-full sm:h-[380px] md:h-[580px]">
      <img src={image} alt={title} class="h-full w-full object-cover" />

      <div class="absolute inset-0 bg-linear-to-t from-(--color-primary) via-[var(--color-primary)/45] to-transparent" />

      <div class="absolute inset-0 mx-auto flex w-full max-w-[80%] items-end justify-between px-4 pb-6 sm:px-8 sm:pb-8 md:pb-10">
        <h1 class="font-jakarta block w-[386px] text-xl leading-[1.05] font-bold wrap-break-word text-white uppercase drop-shadow-xl sm:text-3xl md:text-[40px]">
          {title}
        </h1>

        <Button
          variant="primary"
          size="default"
          class="font-poppins text-sm font-medium text-white shadow-md shadow-white/50 transition hover:shadow-none sm:text-base md:text-lg lg:text-xl"
        >
          Read More
        </Button>
      </div>
    </div>
  )
}
