---
import Button from "./Button.astro";

interface Card {
    variant: 'programs' | 'works' | 'activities' | 'structure-orga' | 'core-team'
    category: string[] | string
}

const { variant = "programs", image, title, desc, titleButton, category } = Astro.props;
---

{
    variant === 'programs' && (
        <div class="relative w-full h-[380px] sm:h-[420px] md:h-[460px] rounded-2xl overflow-hidden shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition shrink-0">
            <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />

            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-transparent" />

            <div class="absolute bottom-0 p-4 sm:p-5 text-white">
                <h2 class="text-lg sm:text-xl md:text-2xl font-poppins font-semibold">{title}</h2>
                <p class="font-poppins font-normal text-xs sm:text-sm opacity-90 tracking-tight">{desc}</p>

                <Button variant="primary" size="full" class="mt-3 text-white font-semibold text-xs sm:text-sm md:text-base font-poppins p-2.5 rounded-xl">
                    {titleButton}
                </Button>
            </div>
        </div>
    )
}

{
    variant === 'works' && (
        <div class="relative w-[340px] sm:w-[420px] md:w-[580px] h-[420px] sm:h-[500px] md:h-[560px] rounded-2xl overflow-hidden shadow-[4px_6px_14px_rgba(0,0,0,0.25)] bg-black transition shrink-0">
            <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />

            <div class="absolute inset-0 bg-black/55" />

            <div class="absolute bottom-0 p-5 sm:p-7 md:p-9 text-white font-jakarta flex flex-col gap-2">
                <div class="bg-white text-black w-fit px-3 py-1.5 rounded-full font-medium text-xs sm:text-sm tracking-tight">
                    <span>{category}</span>
                </div>

                <h2 class="text-2xl sm:text-[28px] md:text-[32px] leading-tight tracking-tight font-semibold">{title}</h2>
                <p class="text-sm sm:text-base opacity-85 font-normal">{desc}</p>
            </div>
        </div>
    )
}

{
    variant === 'activities' && (
        <div class="relative w-[360px] sm:w-[520px] md:w-[656px] h-[500px] sm:h-[540px] md:h-[575px] rounded-3xl p-3.5 overflow-hidden flex flex-col justify-between  bg-white transition shrink-0">
            <img src={image} alt={title} class="object-cover rounded-xl w-full h-[260px] sm:h-[320px] md:h-[359px]" loading="lazy" />

            <div class="text-[var(--text-secondary)] font-jakarta flex flex-col gap-2 mt-2">
                <h2 class="text-2xl sm:text-[28px] md:text-[32px] tracking-tight font-semibold">{title}</h2>
                <p class="text-sm sm:text-base opacity-85 font-normal tracking-normal w-[541.7px] text-start mb-2">{desc}</p>

                {category.length > 0 && (
                    <div class=" flex gap-2">
                        {category.map((cat: string) => (
                            <div class="bg-[var(--color-primary)] text-white w-fit px-5 py-2.5 rounded-full font-medium text-sm sm:text-base tracking-tight">
                                <span>{cat}</span>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>
    )
}

{
    variant === 'structure-orga' && (
        <div
            class="relative w-[174px]  min-h-[157px]  rounded-lg p-[2px]
    bg-gradient-to-br from-[var(--color-primary)]/80 to-white shadow-xl"
        >
            <div class="rounded-lg py-6 px-3 bg-white w-full h-full">
                <div class=" flex flex-col h-full">
                    <div class="rounded-full bg-[var(--color-primary)] p-1.5 w-fit mb-3">
                        <img src="/assets/icons/horn.svg" alt="" class="w-5 h-5 sm:w-7 sm:h-7" />
                    </div>

                    <div class="mt-auto">
                        <h2 class="font-jakarta font-semibold text-[14px] sm:text-[16px] ">{title}</h2>
                        <p class="font-jakarta font-normal text-[10px] sm:text-[12px] tracking-wide ">{desc}</p>
                    </div>
                </div>
            </div>
        </div>
    )
}

{
    variant === 'division' && (
        <div class="relative w-full h-[300px] sm:h-[380px] md:h-[580px]">
            <img src={image} alt={title} class="w-full h-full object-cover " />

            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-primary)] via-[var(--color-primary)/45] to-transparent" />

            <div class="absolute inset-0 w-full max-w-[80%] mx-auto flex items-end justify-between px-4 sm:px-8  pb-6 sm:pb-8 md:pb-10">
                <h1 class="font-jakarta font-bold uppercase text-white text-xl sm:text-3xl md:text-[40px] w-[386px] drop-shadow-xl block break-words leading-[1.05]">{title}</h1>

                <Button
                    variant="primary"
                    size="default"
                    class="text-sm sm:text-base md:text-lg lg:text-xl text-white font-poppins font-medium hover:shadow-none transition  shadow-md shadow-white/50"
                >
                    Read More
                </Button>
            </div>
        </div>

        <h2 class="text-[32px] leading-tight font-semibold tracking-tight">{title}</h2>

        <p class="text-base font-normal opacity-85">{desc}</p>
      </div>
    </div>
  )
}

{
  variant === "core-team" && (
    <div class="flex max-w-xs flex-col gap-3 rounded-xl bg-[#0A84DC] p-4">
      <img src={image} alt={title} class="rounded-lg" />
      <div class="flex flex-col gap-2 text-white">
        <p class="text-3xl font-bold">{title}</p>
        <p class="text-sm">{desc}</p>
      </div>
    </div>
  )
}
