---
import Button from "./Button.astro";

interface Card {
  variant: "programs" | "works";
}

const { variant = "programs", image, title, desc, titleButton, category } = Astro.props;
---

{
  variant === "programs" && (
    <div class="relative h-[420px] w-full overflow-hidden rounded-2xl shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition md:h-[460px]">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/55 to-transparent" />
      <div class="absolute bottom-0 p-5 text-white">
        <h2 class="font-poppins text-xl font-semibold md:text-2xl">{title}</h2>

        <p class="font-poppins text-sm font-normal tracking-tight opacity-90">{desc}</p>

        <Button
          variant="primary"
          size="full"
          class="font-poppins mt-3 rounded-xl p-2.5 text-sm font-semibold text-white md:text-base"
        >
          {titleButton}
        </Button>
      </div>
    </div>
  )
}

{
  variant === "works" && (
    <div class="relative h-[560px] w-[580px] shrink-0 overflow-hidden rounded-2xl bg-black shadow-[4px_6px_14px_rgba(0,0,0,0.25)] transition">
      <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />

      <div class="absolute inset-0 bg-black/55 to-transparent" />

      <div class="font-jakarta absolute bottom-0 flex flex-col gap-2 p-9 text-white">
        <div class="w-fit rounded-full bg-white px-3 py-1.5 text-sm font-medium tracking-tight text-black">
          <span>{category}</span>
        </div>

        <h2 class="text-[32px] leading-tight font-semibold tracking-tight">{title}</h2>

        <p class="text-base font-normal opacity-85">{desc}</p>
      </div>
    </div>
  )
}

{
  variant === "core-team" && (
    <div class="flex max-w-xs flex-col gap-3 rounded-xl bg-[#0A84DC] p-4">
      <img src={image} alt={title} class="rounded-lg" />
      <div class="flex flex-col gap-2 text-white">
        <p class="text-3xl font-bold">{title}</p>
        <p class="text-sm">{desc}</p>
      </div>
    </div>
  )
}

{
    variant === 'division' && (
        <div class="relative w-full h-[300px] sm:h-[380px] md:h-[580px]">
            <img src={image} alt={title} class="w-full h-full object-cover " />

            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-primary)] via-[var(--color-primary)/45] to-transparent" />

            <div class="absolute inset-0 w-full max-w-[80%] mx-auto flex items-end justify-between px-4 sm:px-8  pb-6 sm:pb-8 md:pb-10">
                <h1 class="font-jakarta font-bold uppercase text-white text-xl sm:text-3xl md:text-[40px] w-[386px] drop-shadow-xl block break-words leading-[1.05]">{title}</h1>

                <Button
                    variant="primary"
                    size="default"
                    class="text-sm sm:text-base md:text-lg lg:text-xl text-white font-poppins font-medium hover:shadow-none transition  shadow-md shadow-white/50"
                >
                    Read More
                </Button>
            </div>
        </div>

        <h2 class="text-[32px] leading-tight font-semibold tracking-tight">{title}</h2>

        <p class="text-base font-normal opacity-85">{desc}</p>
    )
      </div>
    </div>
  
}

{
  variant === 'division' && (
    <div class="relative h-[300px] w-full sm:h-[380px] md:h-[580px]">
      <img src={image} alt={title} class="h-full w-full object-cover" />

      <div class="absolute inset-0 bg-linear-to-t from-(--color-primary) via-[var(--color-primary)/45] to-transparent" />

      <div class="absolute inset-0 mx-auto flex w-full max-w-[80%] items-end justify-between px-4 pb-6 sm:px-8 sm:pb-8 md:pb-10">
        <h1 class="font-jakarta block w-[386px] text-xl leading-[1.05] font-bold wrap-break-word text-white uppercase drop-shadow-xl sm:text-3xl md:text-[40px]">
          {title}
        </h1>

        <Button
          variant="primary"
          size="default"
          class="font-poppins text-sm font-medium text-white shadow-md shadow-white/50 transition hover:shadow-none sm:text-base md:text-lg lg:text-xl"
        >
          Read More
        </Button>
      </div>
    </div>
  )
}
