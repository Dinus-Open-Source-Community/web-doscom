---
import Button from './Button.astro';
import arrowIcon from '../../assets/icon-arrow.svg?raw';
import { ROUTES } from '../../lib/routes';

interface Props {
	variant:
		| 'programs'
		| 'core-team'
		| 'works'
		| 'activities'
		| 'structure-orga'
		| 'projects'
		| 'blogs'
		| 'division';
	image?: string;
	title?: string;
	desc?: string;
	titleButton?: string;
	category?: string[] | string;
	tags?: string[];
	index?: number;
	slug?: string;
}

const {
	variant = 'programs',
	image,
	title,
	desc,
	titleButton,
	category,
	tags = [],
	index = 0,
	slug = '',
}: Props = Astro.props;

const categories = Array.isArray(category) ? category : category ? [category] : [];
---

{
	variant === 'programs' && (
		<div class="relative h-[380px] sm:w-full w-4/5 max-w-sm shrink-0 font-jakarta overflow-hidden rounded-2xl shadow-[6px_10px_20px_rgba(0,0,0,0.40)] transition sm:h-[420px] md:h-[460px]">
			<img
				src={image}
				alt={title}
				class="absolute inset-0 h-full w-full object-cover"
				loading="lazy"
			/>

			<div class="absolute inset-0 bg-linear-to-t from-black via-black/55 to-transparent" />

			<div class="absolute bottom-0 p-4 text-white sm:p-5">
				<h2 class="font-poppins text-lg font-semibold sm:text-xl md:text-2xl">
					{title}
				</h2>
				<p class="font-poppins text-xs font-normal tracking-tight opacity-90 sm:text-sm">
					{desc}
				</p>

				<Button
					variant="primary"
					size="full"
					class="font-poppins mt-3 rounded-xl p-2.5 text-xs font-semibold text-white sm:text-sm md:text-base"
				>
					{titleButton}
				</Button>
			</div>
		</div>
	)
}

{
	variant === 'core-team' && (
		<div class="flex h-full w-full flex-col gap-3 rounded-xl bg-[#0a84dc] px-4 pt-4 pb-7">
			<img src={image} alt={title} class="rounded-lg" />
			<div class="flex flex-col gap-1 text-white">
				<p class="text-3xl font-bold">{title}</p>
				<p class="text-sm">{desc}</p>
			</div>
		</div>
	)
}

{
	variant === 'works' && (
		<div class="relative h-[420px] w-[340px] shrink-0 overflow-hidden rounded-2xl bg-black shadow-[4px_6px_14px_rgba(0,0,0,0.25)] transition sm:h-[500px] sm:w-[420px] md:h-[560px] md:w-[580px]">
			<img
				src={image}
				alt={title}
				class="absolute inset-0 h-full w-full object-cover"
				loading="lazy"
			/>

			<div class="absolute inset-0 bg-black/55" />

			<div class="font-jakarta absolute bottom-0 flex flex-col gap-2 p-5 text-white sm:p-7 md:p-9">
				<div class="w-fit rounded-full bg-white px-3 py-1.5 text-xs font-medium tracking-tight text-black sm:text-sm">
					<span>{category}</span>
				</div>

				<h2 class="text-2xl leading-tight font-semibold tracking-tight sm:text-[28px] md:text-[32px]">
					{title}
				</h2>
				<p class="text-sm font-normal opacity-85 sm:text-base">{desc}</p>
			</div>
		</div>
	)
}

{
	variant === 'activities' && (
		<div class="relative flex h-[500px] w-[360px] shrink-0 flex-col justify-between overflow-hidden rounded-3xl bg-white p-3.5 transition  md:h-[575px] md:w-[656px]">
			<img
				src={image}
				alt={title}
				class="h-[260px] w-full rounded-xl object-cover sm:h-80 md:h-[359px]"
				loading="lazy"
			/>

			<div class="font-jakarta mt-2 flex flex-col gap-2 text-(--text-secondary)">
				<h2 class="text-2xl font-semibold tracking-tight  md:text-[32px]">
					{title}
				</h2>
				<p class="mb-2 md:w-[541.7px] w-full text-start text-sm font-normal tracking-normal opacity-85 sm:text-base">
					{desc}
				</p>

				{categories.length > 0 && (
					<div class="flex gap-2">
						{categories.map((cat) => (
							<div class="w-fit rounded-full bg-(--color-primary) px-5 py-2.5 text-sm font-medium tracking-tight text-white sm:text-base">
								<span>{cat}</span>
							</div>
						))}
					</div>
				)}
			</div>
		</div>
	)
}

{
	variant === 'structure-orga' && (
		<div class="relative min-h-[157px] w-[200px] rounded-lg bg-linear-to-br from-(--color-primary)/80 to-white p-0.5 shadow-xl">
			<div class="h-full w-full rounded-lg bg-white px-3 py-6">
				<div class="flex h-full flex-col">
					<div class="mb-3 w-fit rounded-full bg-(--color-primary) p-1.5">
						<img
							src="/assets/icons/horn.svg"
							alt=""
							class="h-5 w-5 sm:h-7 sm:w-7"
						/>
					</div>

					<div class="mt-auto">
						<h2 class="font-jakarta text-[14px] font-semibold sm:text-[16px]">
							{title}
						</h2>
						<p class="font-jakarta text-[10px] font-normal tracking-wide sm:text-[12px]">
							{desc}
						</p>
					</div>
				</div>
			</div>
		</div>
	)
}

{
	variant === 'division' && (
		<div class="relative md:h-[880px] h-full w-full ">
			<img src={image} alt={title} class="h-full w-full object-cover" />

			<div class="absolute inset-0 bg-linear-to-t from-(--color-primary) via-(--color-primary)/40  to-(--color-primary)/0" />

			<div class="absolute inset-0 mx-auto flex w-full md:max-w-[80%] items-end justify-between px-4 pb-6 sm:px-8 sm:pb-8 md:pb-10">
				<h1 class="font-jakarta block md:w-[386px] w-[70%] md:text-xl text-base leading-[1.05] font-bold wrap-break-word text-white uppercase drop-shadow-xl sm:text-3xl md:text-[40px]">
					{title}
				</h1>

				<Button
					variant="primary"
					size="default"
					class="font-poppins text-sm font-medium text-white shadow-md shadow-white/50 transition hover:shadow-none lg:text-xl"
				>
					<a href={ROUTES.division.detail(slug)}>Read More</a>
				</Button>
			</div>
		</div>
	)
}

{
	variant === 'projects' && (
		<div class="group relative block aspect-square w-full overflow-hidden rounded-xl bg-gray-200 transition-all hover:shadow-lg">
			<div class="h-full w-full bg-gray-200 transition-transform duration-500 group-hover:scale-105">
				<img
					src={image}
					alt={title}
					class="h-full w-full object-cover"
					loading="lazy"
				/>
			</div>
			<div class="absolute inset-0 min-h-screen bg-[#0E0E0E]/60" />

			<div class="absolute bottom-0 left-0 w-full p-6">
				<h3 class="text-xl font-bold text-white transition-colors group-hover:text-[var(--color-primary)]">
					{title}
				</h3>
				<p class="text-sm font-medium text-gray-300">{category}</p>
			</div>
		</div>
	)
}

{
	variant === 'blogs' && (
		<div class="group relative flex aspect-video h-72 w-full flex-col justify-end overflow-hidden rounded-xl bg-gray-200 p-6 transition-all hover:shadow-lg">
			{image ? (
				<>
					<img
						src={image}
						alt={title}
						class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-black/40" />
				</>
			) : (
				<div class="absolute inset-0 bg-gray-300 transition-colors group-hover:bg-gray-400" />
			)}

			<div class="relative z-10 flex items-end justify-between">
				<div>
					<h3 class="mb-2 text-xl font-bold text-white">
						{title}
					</h3>

					<div class="flex gap-2">
						{tags.map((tag) => (
							<span class="rounded-full bg-white/20 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">
								{tag}
							</span>
						))}
					</div>
				</div>

				<button
					class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-black/10 transition-colors hover:bg-black/20"
					aria-label="Read more"
				>
					<span
						class="h-7 w-7 text-gray-800 [&>svg]:h-full [&>svg]:w-full"
						set:html={arrowIcon}
					/>
				</button>
			</div>
		</div>
	)
}
