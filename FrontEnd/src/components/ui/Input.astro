---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  type?: "text" | "email" | "number" | "password" | "tel" | "textarea";
  label?: string;
  readonly?: boolean;
}

const { type = "text", class: className, placeholder, ...props } = Astro.props;

// Style dasar sesuai desainmu (Tailwind)
// Saya gabungkan style agar konsisten
const baseStyles =
  "w-full rounded-xl border-2 border-[#BDBDBD] py-3 px-5 placeholder:font-jakarta text-xl placeholder:font-semibold placeholder:text-[#BDBDBD] focus:border-[var(--color-primary)] focus:outline-none bg-transparent transition-colors duration-200";
---

{
  type === "textarea" ? (
    <textarea
      class:list={[baseStyles, "resize-none", className]}
      rows="8"
      {...props}
      placeholder={placeholder ?? ""}
    />
  ) : (
    <input
      type={type}
      class:list={[baseStyles, className]}
      {...props}
      placeholder={placeholder ?? ""}
    />
  )
}
