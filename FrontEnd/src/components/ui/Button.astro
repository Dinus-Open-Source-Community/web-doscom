---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'small' | 'default' | 'large' | 'icon';
  class?: string;
}

const { variant = 'primary', size = 'default', class: extraClass = '' } = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center rounded-full font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-offset-2';

const variantStyles: Record<string, string> = {
  primary:
    'bg-[var(--color-primary)] text-[var(--text-primary)] hover:shadow-md hover:opacity-95 focus-visible:ring-[var(--color-primary)]',
  secondary:
    'bg-[var(--color-secondary)] text-[var(--text-primary)] hover:shadow-xs ',
  outline:
    'bg-transparent text-[var(--text-primary)] border border-[var(--color-primary)] hover:bg-[var(--color-primary)]',
};

const sizeStyles: Record<string, string> = {
  small: 'px-4 py-2 text-sm sm:px-5 sm:py-2.5 sm:text-base',
  default: 'px-5 py-2.5 text-base sm:px-7 sm:py-3 sm:text-lg',
  large: 'px-6 py-3 text-lg sm:px-10 sm:py-4 sm:text-xl',
  icon: 'p-2 sm:p-3 text-base',
};
---

<button class={`${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${extraClass}`}>
  <slot />
</button>
