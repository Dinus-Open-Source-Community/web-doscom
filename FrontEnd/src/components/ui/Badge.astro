---
interface Props {
  status: 'Completed' | 'Refunded' | 'Canceled' | string
}

const { status } = Astro.props

const styles = {
  Completed: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  Refunded: 'bg-amber-50 text-amber-700 border-amber-200',
  Canceled: 'bg-rose-50 text-rose-700 border-rose-200',
}

const currentStyle = styles[status as keyof typeof styles] || 'bg-gray-50 text-gray-700 border-gray-200'
---

<span
  class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full border cursor-default select-none ${currentStyle}`}
>
  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
  {status}
</span>
