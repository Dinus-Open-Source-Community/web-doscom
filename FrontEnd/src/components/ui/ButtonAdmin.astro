---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  variant?:
    | 'primary'
    | 'secondary'
    | 'outline'
    | 'admin-primary'
    | 'admin-outline'
    | 'admin-cyan-primary'
    | 'admin-cyan-outline'
  size?: 'small' | 'default' | 'large' | 'icon' | 'full'
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full'
  class?: string
}

const { variant = 'primary', size = 'default', rounded, class: extraClass = '', ...rest } = Astro.props

const baseStyles =
  'inline-flex items-center justify-center transition-all duration-200 font-semibold focus-visible:ring-2 focus-visible:ring-offset-2'

const variantStyles = {
  primary:
    'bg-[var(--color-primary)] text-[var(--text-primary)] hover:shadow-md hover:opacity-95 focus-visible:ring-[var(--color-primary)] cursor-pointer',
  secondary: 'bg-[var(--color-secondary)] text-[var(--text-primary)] hover:shadow-xs cursor-pointer',
  outline: 'bg-transparent text-[var(--text-primary)] border-3 border-[var(--color-primary)] cursor-pointer',

  'admin-primary': 'bg-gray-900 text-white hover:bg-gray-800 shadow-sm focus-visible:ring-gray-900 cursor-default',
  'admin-outline':
    'border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 shadow-sm focus-visible:ring-gray-200 cursor-default',

  'admin-cyan-primary':
    'border border-cyan-600 bg-cyan-600 text-white shadow-sm hover:bg-cyan-500 focus-visible:ring-cyan-600 cursor-default',
  'admin-cyan-outline':
    'border border-cyan-200 bg-cyan-50 text-cyan-700 shadow-sm hover:bg-cyan-100/80 focus-visible:ring-cyan-200 cursor-default',
}

const roundedStyles = {
  none: 'rounded-none',
  sm: 'rounded-sm',
  md: 'rounded-md',
  lg: 'rounded-lg',
  xl: 'rounded-xl',
  '2xl': 'rounded-2xl',
  full: 'rounded-full',
}

const defaultRounded = variant.startsWith('admin-') ? 'xl' : 'full'
const currentRounded = rounded ? roundedStyles[rounded] : roundedStyles[defaultRounded]

const sizeStyles = {
  small: 'px-4 py-2 text-sm gap-2',
  default: 'px-5 py-2 sm:px-8 sm:py-2.5 gap-2.5',
  large: 'px-6 py-2.5 sm:px-9 sm:py-3 gap-3',
  icon: 'p-2 sm:p-3',
  full: 'w-full gap-2.5',
}
---

<button class={`${baseStyles} ${variantStyles[variant]} ${currentRounded} ${sizeStyles[size]} ${extraClass}`} {...rest}>
  <slot />
</button>
