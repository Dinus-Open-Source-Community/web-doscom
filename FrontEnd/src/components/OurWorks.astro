---
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';

interface WorkItem {
	image_url: string;
	title: string;
	description: string;
	project_type: string;
	slug: string;
}

interface Props {
	items: WorkItem[];
}

const { items } = Astro.props;
---

<div class="w-full bg-white">
	<div
		class="w-full md:max-w-7xl max-w-full h-full mx-auto pt-5 md:pt-10 px-4 md:px-6"
	>
		<div class="w-full">
			<h1 class="font-bold text-4xl md:text-[42px] font-jakarta">Our Works</h1>
		</div>
		<div
			class="flex flex-col md:flex-row justify-between items-start md:items-end mt-2 mb-4 gap-4"
		>
			<p
				class="text-[var(--text-secondary)] font-normal text-base md:text-lg font-jakarta leading-relaxed"
			>
				A list of planned activities that will be implemented to <br
					class="hidden md:block"
				/> achieve organizational goals in a structured and <br
					class="hidden md:block"
				/> sustainable manner.
			</p>
			<div class="hidden gap-2 md:flex">
				<Button id="works-btn-left" variant="primary" size="icon"
					><img
						src="/assets/icons/arrowleft.svg"
						alt="arrow left"
						width="24"
						height="24"
					/>
				</Button>
				<Button id="works-btn-right" variant="primary" size="icon"
					><img
						src="/assets/icons/arrowright.svg"
						alt="arrow right"
						width="24"
						height="24"
					/></Button
				>
			</div>
		</div>
	</div>

	<div
		id="works-carousel"
		class="flex gap-4 md:gap-6 overflow-x-auto relative w-full py-4 overflow-visible no-scrollbar md:px-10 snap-x scroll-smooth"
	>
		{items.map((item) => (
			<Card
				image={item.image_url}
				variant="works"
				title={item.title}
				desc={item.description}
				category={item.project_type}
			/>
		))}
	</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('works-carousel')
    const btnLeft = document.getElementById('works-btn-left')
    const btnRight = document.getElementById('works-btn-right')

    if (btnLeft && btnRight && carousel) {
      btnLeft.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' })
      })

      btnRight.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: cardWidth + gap, behavior: 'smooth' })
      })
    }
  })
</script>
