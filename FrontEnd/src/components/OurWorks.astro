---
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
---

<div class="w-full">
    <div class="w-full max-w-7xl h-full mx-auto mt-12 md:mt-16 px-4 md:px-6">
        <div class="w-full">
            <h1 class="font-semibold text-3xl md:text-4xl font-jakarta">Our Works</h1>
        </div>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mt-4 mb-6 gap-4">
            <p class="text-[var(--text-secondary)] font-normal text-base md:text-lg font-jakarta leading-relaxed">
                A list of planned activities that will be implemented to <br class="hidden md:block" /> achieve organizational goals in a structured and <br class="hidden md:block" /> sustainable manner.
            </p>
            <div class="flex gap-2">
                <Button variant="primary" size="icon"><img src="/assets/icons/arrowleft.svg" alt="arrow left" width="24" height="24" /> </Button>
                <Button variant="primary" size="icon"><img src="/assets/icons/arrowright.svg" alt="arrow right" width="24" height="24" /></Button>
            </div>
        </div>
    </div>

    <div class="flex gap-4 md:gap-6 overflow-x-auto relative w-full py-4 overflow-visible no-scrollbar px-4 md:px-10 snap-x scroll-smooth">
        <Card
            image="/assets/image/Dform.png"
            variant="works"
            title="TealinuxOS"
            desc="A digital platform for community event attendance and registration"
            category="Operation System"
        />
        <Card
            image="/assets/image/tealinux.png"
            variant="works"
            title="TealinuxOS"
            desc="A Linux-based operating system with a lightweight and user-friendly interface."
            category="Operation System"
        />
        <Card image="/assets/image/Dform.png" variant="works" title="Rice Source" desc="An open-source repository for community projects and experiments" category="Open Source" />
    </div>
</div>
