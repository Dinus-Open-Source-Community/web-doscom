---
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';

interface WorkItem {
	image_url: string;
	title: string;
	description: string;
	project_type: string;
	slug: string;
}

interface Props {
	items: WorkItem[];
}

const { items } = Astro.props;
---

<div
	class="md:max-w-7xl max-w-3xl relative font-jakarta w-full h-full md:mx-auto pt-12 md:pt-16 md:px-6 bg-white"
>
	<div class="w-full px-2">
		<h1 class="font-semibold text-3xl md:text-5xl font-jakarta">
			Our Programs
		</h1>
	</div>
	<div
		class="flex flex-col md:flex-row justify-between items-start md:items-end mt-2 mb-8 gap-4 px-2"
	>
		<p
			class="text-[var(--text-secondary)] font-normal text-base md:text-lg font-jakarta leading-relaxed"
		>
			A list of planned activities that will be implemented to <br
				class="hidden md:block"
			/> achieve organizational goals in a structured and <br
				class="hidden md:block"
			/> sustainable manner.
		</p>

		<div class="hidden md:flex gap-2 md:sticky top-0 right-4">
			<Button id="programs-btn-left" variant="primary" size="icon">
				<img
					src="/assets/icons/arrowleft.svg"
					alt="arrow left"
					width="24"
					height="24"
				/>
			</Button>
			<Button id="programs-btn-right" variant="primary" size="icon">
				<img
					src="/assets/icons/arrowright.svg"
					alt="arrow right"
					width="24"
					height="24"
				/>
			</Button>
		</div>
	</div>

	<div
		id="programs-carousel"
		class="relative flex flex-row overflow-x-auto pt-2 no-scrollbar gap-4 md:gap-6"
	>
		{items.map((item) => (
			<Card
				image={item.image_url}
				title={item.title}
				desc={item.description}
				titleButton="Look Now"
				variant="programs"
			/>
		))}
	</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('programs-carousel')
    const btnLeft = document.getElementById('programs-btn-left')
    const btnRight = document.getElementById('programs-btn-right')

    if (btnLeft && btnRight && carousel) {
      btnLeft.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' })
      })

      btnRight.addEventListener('click', () => {
        const cardWidth = carousel.firstElementChild?.clientWidth || 0
        const gap = parseFloat(getComputedStyle(carousel).columnGap) || 0
        carousel.scrollBy({ left: cardWidth + gap, behavior: 'smooth' })
      })
    }
  })
</script>
