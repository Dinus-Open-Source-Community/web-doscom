---
import Button from '../ui/Button.astro'
import Logo from '../../assets/logo-doscom.svg?raw'

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Division', href: '/division' },
  { name: 'Works', href: '/works' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
]

const currentPath = Astro.url.pathname
---

<nav class="absolute top-8 left-0 z-30 flex w-full justify-center">
  <div
    class="grid w-full max-w-[96rem] grid-cols-[1fr_auto_1fr] items-center rounded-full bg-white px-8 py-3 text-black drop-shadow-xl backdrop-blur-md"
  >
    <span
      class="w-36 text-[var(--color-primary)] [&>svg]:h-full [&>svg]:w-full"
      set:html={Logo}
    />

    <ul class="flex justify-center gap-10 text-lg font-normal">
      {
        navItems.map(item => {
          const isActive =
            currentPath === item.href ||
            (item.href !== '/' && currentPath.startsWith(item.href))

          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]',
                  isActive ? 'font-semibold text-[#0A84DC]' : '',
                ]}
              >
                {item.name}
              </a>
            </li>
          )
        })
      }
    </ul>

    <div class="flex justify-end">
      <Button variant="primary" class="py-0 font-semibold text-white"
        >Join Us</Button
      >
    </div>
  </div>
</nav>
