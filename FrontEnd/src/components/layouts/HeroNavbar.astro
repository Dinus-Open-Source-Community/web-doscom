---
import Button from "..//ui/Button.astro";
---

<nav class="absolute top-8 left-0 z-20 flex w-full justify-center">
  <div
    class="grid w-full max-w-7xl grid-cols-3 items-center rounded-full bg-white px-8 py-3 text-black backdrop-blur-md"
  >
    <img src="/assets/logo/logo-doscom.svg" alt="Logo DOSCOM" class="h-8 w-auto" />

    <ul class="flex justify-center gap-6 text-xl font-normal">
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Home</li>
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">About</li>
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Divisions</li>
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Works</li>
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Blog</li>
      <li class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Contact</li>
    </ul>

    <div class="flex justify-end">
      <Button variant="primary" class="font-normal text-white">Join Us</Button>
    </div>
  </div>
</nav>
