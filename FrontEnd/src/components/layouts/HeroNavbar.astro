---
import Button from '../ui/Button.astro'
import Logo from '../../assets/logo-doscom.svg?raw'
---

<nav class="absolute top-8 left-0 z-20 flex w-full justify-center">
  <div
    class="grid w-full max-w-[96rem] grid-cols-[1fr_auto_1fr] items-center rounded-full bg-white px-8 py-3 text-black drop-shadow-xl backdrop-blur-md"
  >
    <!-- <img src="/assets/logo/logo-doscom.svg" alt="Logo DOSCOM" class="h-8 w-auto" /> -->
    <span class="w-36 text-[var(--color-primary)] [&>svg]:h-full [&>svg]:w-full" set:html={Logo} />

    <ul class="flex justify-center gap-6 text-xl font-normal">
      <li><a href="/" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Home</a></li>
      <li><a href="/about" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">About</a></li>
      <li><a href="#" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Divisions</a></li>
      <li><a href="/works" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Works</a></li>
      <li><a href="/blog" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Blog</a></li>
      <li>
        <a href="#" class="cursor-pointer transition-colors duration-200 hover:text-[#0A84DC]">Contact</a>
      </li>
    </ul>

    <div class="flex justify-end">
      <Button variant="primary" class="font-semibold text-white">Join Us</Button>
    </div>
  </div>
</nav>
