---
import { Join } from '../../assets/icons'
import Logo from '../../assets/logo-doscom.svg?raw'

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Division', href: '/division' },
  { name: 'Works', href: '/works' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
]

const currentPath = Astro.url.pathname
---

<nav
  id="sticky-nav"
  class="font-jakarta fixed top-0 left-0 z-[60] w-full -translate-y-full transform bg-white/90 px-6 py-4 text-black shadow-lg backdrop-blur-md transition-all duration-500 ease-out md:px-10"
>
  <div class="mx-auto flex max-w-[1500px] items-center justify-between">
    <a href="/" class="w-32 text-[#0A84DC] md:w-36 [&>svg]:h-full [&>svg]:w-full" set:html={Logo} />

    <ul class="hidden gap-8 text-base font-normal tracking-wider lg:flex">
      {
        navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition-colors duration-200 hover:text-[#0A84DC]',
                currentPath === item.href ? 'font-bold text-[#0A84DC]' : '',
              ]}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <button
        class="flex items-center justify-center rounded-full bg-[#0A84DC] px-4 py-2 font-semibold text-white transition-transform hover:scale-105 active:scale-95 md:px-6 md:py-2"
      >
        <span class="hidden md:block">Join Us</span>
        <div class="h-5 w-5 md:hidden [&>svg]:h-full [&>svg]:w-full" set:html={Join} />
      </button>

      <button
        id="sticky-menu-trigger"
        class="flex h-10 w-10 flex-col items-center justify-center gap-1 rounded-full bg-gray-100 lg:hidden"
      >
        <span class="h-0.5 w-4 bg-black"></span>
        <span class="h-0.5 w-4 bg-black"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('sticky-nav')
  const stickyTrigger = document.getElementById('sticky-menu-trigger')
  let isMenuOpen = false // Flag status menu

  function handleScroll() {
    if (!nav || isMenuOpen) return // Jika menu buka, abaikan logic scroll

    const triggerPoint = window.innerHeight * 0.8
    if (window.scrollY > triggerPoint) {
      nav.classList.remove('-translate-y-full')
    } else {
      nav.classList.add('-translate-y-full')
    }
  }

  // Dengerin sinyal dari React untuk sembunyi/muncul
  window.addEventListener('toggle-sticky-visibility', ((e: CustomEvent) => {
    isMenuOpen = e.detail.hidden

    if (isMenuOpen) {
      // Geser ke atas dengan smooth saat menu dibuka
      nav?.classList.add('-translate-y-full')
    } else {
      // Cek lagi posisi scroll saat menu ditutup
      handleScroll()
    }
  }) as EventListener)

  stickyTrigger?.addEventListener('click', () => {
    const event = new CustomEvent('open-mobile-menu')
    window.dispatchEvent(event)
  })

  window.addEventListener('scroll', handleScroll)
</script>
