---
import Button from "../ui/Button.astro";
---

<header class="absolute z-20 w-full flex justify-center py-6 md:py-8 px-4">
  <nav class="flex w-full max-w-7xl items-center justify-between bg-white rounded-full px-4 md:px-8 py-2 md:py-3 shadow-lg">
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <img src="/assets/logo/logo-doscom.svg" alt="Logo DOSCOM" class="h-6 md:h-8 w-auto" />
    </a>

    <!-- Menu Items -->
    <div class="hidden md:flex items-center gap-6 lg:gap-8">
      <a href="/" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">Home</a>
      <a href="/about" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">About</a>
      <a href="/division" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">Division</a>
      <a href="/works" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">Works</a>
      <a href="/blog" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">Blog</a>
      <a href="/contact" class="text-sm font-medium text-gray-700 hover:text-[#0A84DC] transition-colors">Contact</a>
    </div>

    <!-- Right Button -->
    <div>
      <Button variant="primary" class="rounded-full px-6 py-2 text-sm font-medium text-white shadow-md hover:shadow-lg transition-all">
        Join Us
      </Button>
    </div>
  </nav>
</header>
