---
import { ChevronDown } from "../../assets/icons";

interface Props {
  item: any;
}

const { item } = Astro.props;
---

<li class="relative group/item">
  {
    item.submenu ? (
      <div class="menu-item-with-submenu">
        <button
          class:list={[
            "w-full flex items-center px-2 py-2.5 rounded-lg transition-colors duration-200 cursor-pointer submenu-toggle",
            item.active
              ? "bg-cyan-50 text-cyan-700 hover:bg-cyan-100/70"
              : "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
          ]}
        >
          <span class="w-8 flex justify-center shrink-0">
            <span class="[&>svg]:w-full [&>svg]:h-full" set:html={item.icon} />
          </span>
          <span class="sidebar-text grow text-left font-semibold text-sm">{item.name}</span>

          <span
            set:html={ChevronDown}
            class="transition-transform duration-300 shrink-0 submenu-arrow [&>svg]:w-4 [&>svg]:h-4"
          />
        </button>

        <div class="submenu-wrapper grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
          <div class="overflow-hidden">
            <ul class="submenu-list space-y-1 mt-1">
              {item.submenu.map((subitem: any) => (
                <li>
                  <a
                    href={subitem.href}
                    class="w-full flex items-center px-2 py-2 text-sm text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-50 transition-colors group/subitem relative"
                  >
                    <span class="w-8 flex justify-center shrink-0 opacity-70">
                      <span class="[&>svg]:w-full [&>svg]:h-full" set:html={subitem.icon} />
                    </span>
                    <span class="sidebar-text grow text-left font-semibold text-sm">{subitem.name}</span>

                    <div class="simple-tooltip absolute left-full ml-4 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 invisible group-hover/subitem:opacity-100 group-hover/subitem:visible transition-all duration-200 z-50 pointer-events-none">
                      {subitem.name}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ) : (
      <a
        href={item.href}
        class:list={[
          "w-full flex items-center px-2 py-2.5 rounded-lg transition-colors duration-200",
          item.active
            ? "bg-cyan-50 text-cyan-700 hover:bg-cyan-100/70"
            : "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
        ]}
      >
        <span class="w-8 flex justify-center shrink-0">
          <span class="[&>svg]:w-4 [&>svg]:h-4" set:html={item.icon} />
        </span>
        <span class="sidebar-text grow text-left font-semibold text-sm">{item.name}</span>

        <div class="simple-tooltip absolute left-full ml-3 opacity-0 invisible -translate-x-2 group-hover/item:opacity-100 group-hover/item:visible group-hover/item:translate-x-0 transition-all duration-300 ease-out z-50 pointer-events-none">
          <div class="relative bg-gray-900 text-white text-xs font-medium px-3 py-1.5 rounded-md shadow-lg whitespace-nowrap">
            <div class="absolute w-2 h-2 bg-gray-900 -left-1 top-1/2 -translate-y-1/2 rotate-45 -z-10" />

            <span class="relative z-10">{item.name}</span>
          </div>
        </div>
      </a>
    )
  }
</li>
