---
import Card from '../../ui/Card.astro'
import type { WorkPublic } from '../../../lib/types'

interface Props {
  works: WorkPublic[]
  types: string[]
  activeType: string
  search: string
}

const { works, types, activeType, search } = Astro.props

function displayType(t: string): string {
  return t.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')
}
---

<section class="relative flex min-h-screen justify-center bg-white">
  <div class="my-12 flex w-full max-w-[96rem] flex-col gap-5">
    <form method="GET" class="flex w-full items-center justify-between gap-4">
      <div class="flex w-full max-w-md items-center gap-2">
        <input
          type="text"
          name="search"
          value={search}
          placeholder="Cari karya..."
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-(--color-primary)"
        />
        <button type="submit" class="rounded-lg bg-(--color-primary) px-4 py-2 text-sm text-white">
          Cari
        </button>
      </div>
      <select
        name="type"
        class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-(--color-primary)"
        onchange="this.form.submit()"
      >
        <option value="">Semua</option>
        {types.map(t => (
          <option value={t} selected={activeType === t}>{displayType(t)}</option>
        ))}
      </select>
    </form>
    <div class="flex flex-col items-center gap-3">
      <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {works.length > 0 ? (
          works.map(w => (
            <a href={"/works/" + w.id} class="block">
              <Card
                variant="projects"
                title={w.title}
                category={w.project_type}
                image={w.image_url}
              />
            </a>
          ))
        ) : (
          <p class="col-span-full text-center text-gray-500 py-12">Tidak ada karya yang ditemukan.</p>
        )}
      </div>


    </div>
  </div>
</section>
