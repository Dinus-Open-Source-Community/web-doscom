---

---

<section class="flex flex-col gap-6">
  {/* Grid Layout ala Bento Grid */}
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:grid-rows-3 md:gap-6">
    {/* Gambar Besar Kiri (Span 2 kolom, 2 baris) */}
    <div
      class="col-span-2 row-span-2 aspect-square overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-1.webp"
        alt="Gallery 1"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>

    {/* Gambar Kanan Atas */}
    <div
      class="col-span-2 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:row-span-1 md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-2.webp"
        alt="Gallery 2"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>

    {/* Gambar Kanan Tengah */}
    <div
      class="col-span-2 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:row-span-1 md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-3.webp"
        alt="Gallery 3"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>

    {/* 3 Gambar Kecil di Bawah */}
    <div
      class="col-span-1 aspect-4/3 overflow-hidden rounded-2xl bg-gray-100 md:col-span-1 md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-4.webp"
        alt="Gallery 4"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>
    <div
      class="col-span-1 aspect-4/3 overflow-hidden rounded-2xl bg-gray-100 md:col-span-1 md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-5.webp"
        alt="Gallery 5"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>
    <div
      class="col-span-2 aspect-21/9 overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:aspect-auto md:rounded-3xl"
    >
      <img
        src="/assets/photos/gallery-6.webp"
        alt="Gallery 6"
        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
      />
    </div>
  </div>
</section>
