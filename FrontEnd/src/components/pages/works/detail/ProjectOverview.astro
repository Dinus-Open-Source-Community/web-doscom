---
import type { WorkPublic } from "@lib/types";

interface Props {
  work: WorkPublic;
}

const { work } = Astro.props as Props;
---

<section class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
  <div class="flex flex-col gap-6 lg:col-span-5">
    <h2
      class="text-2xl leading-snug font-bold text-gray-900 sm:text-3xl lg:text-4xl"
    >
      {work.tagline || work.title}
    </h2>

    {work.technologies && work.technologies.length > 0 && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {work.technologies.map((tech) => (
          <span class="rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-600">
            {tech}
          </span>
        ))}
      </div>
    )}
  </div>

  <div
    class="flex flex-col gap-6 text-base leading-relaxed text-gray-600 lg:col-span-7 lg:pl-12"
  >
    {work.description ? (
      work.description.split("\n").filter(Boolean).map((p) => (
        <p>{p}</p>
      ))
    ) : (
      <p class="text-gray-400 italic">No description available.</p>
    )}
  </div>
</section>
