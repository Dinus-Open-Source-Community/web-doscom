---
// Jika nanti datanya dari API/Props, bisa dilempar ke sini
---

<section class="flex flex-col gap-8">
  {/* Header: Title & Category */}
  <div
    class="flex flex-col items-start justify-between gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-end"
  >
    <h1
      class="text-4xl font-bold tracking-tight text-gray-900 md:text-5xl lg:text-6xl"
    >
      Web Doscom
    </h1>
    <span class="text-lg font-medium text-gray-600 md:text-xl"> Website </span>
  </div>

  {/* Main Cover Image */}
  <div
    class="relative aspect-video w-full overflow-hidden rounded-3xl bg-gray-100 sm:aspect-[21/9]"
  >
    <img
      src="/assets/photos/dummy-cover.webp"
      alt="Web Doscom Cover"
      class="h-full w-full object-cover object-center"
    />
  </div>
</section>
