---
const relatedProjects = [
  { title: 'D-Form', category: 'Website', img: '/assets/photos/dform.webp' },
  {
    title: 'TeaLinuxOS',
    category: 'Operating System',
    img: '/assets/photos/tealinux.webp',
  },
  {
    title: 'Rice Source',
    category: 'Website',
    img: '/assets/photos/rice.webp',
  },
]
---

{/* bg-[#0085FF] disesuaikan dengan biru Doscom di desainmu */}
<section class="w-full bg-[#0085FF] py-16 sm:py-24">
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-white sm:text-4xl">Our Works</h2>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        relatedProjects.map(project => (
          <a
            href="#"
            class="group relative flex aspect-4/3 flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 transition-all hover:-translate-y-2 hover:shadow-xl md:rounded-3xl"
          >
            {/* Background Image */}
            <img
              src={project.img}
              alt={project.title}
              class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity duration-300 group-hover:opacity-80"
            />

            {/* Overlay Gradient biar teksnya terbaca */}
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent" />

            {/* Content */}
            <div class="relative z-10 p-6 sm:p-8">
              <span class="mb-2 inline-block rounded-full bg-white/20 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
                {project.category}
              </span>
              <h3 class="text-xl font-bold text-white sm:text-2xl">
                {project.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
