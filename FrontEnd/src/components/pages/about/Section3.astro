---
import Button from "../../ui/Button.astro";
import Card from "../../ui/Card.astro";
---

<section class="flex min-h-screen justify-center bg-white">
  <div class="mt-10 flex w-full max-w-7xl flex-col gap-10">
    <p class="text-5xl font-bold">Core Team Value</p>
    <div class="grid grid-cols-4 gap-5">
      <Card
        variant="core-team"
        image="/assets/photos/about-pemro-3.webp"
        title="Pemrograman"
        desc="Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi."
      />
      <Card
        variant="core-team"
        image="/assets/photos/about-jaringan-3.webp"
        title="Jaringan"
        desc="Menghubungkan dunia dengan teknologi dan inovasi."
      />
      <Card
        variant="core-team"
        image="/assets/photos/about-data-3.webp"
        title="Data"
        desc="Mengelola informasi untuk keputusan yang lebih baik dan masa depan yang cerdas."
      />
      <Card
        variant="core-team"
        image="/assets/photos/about-crevmed-3.webp"
        title="Creative Media"
        desc="Menggabungkan kreativitas dan teknologi untuk menciptakan konten yang menginspirasi."
      />
    </div>
    <div class="flex justify-between gap-52 py-10">
      <div class="flex w-2/3 flex-col justify-center gap-7">
        <p class="text-8xl font-bold uppercase">our best team</p>
        <p class="text-3xl leading-snug">
          Driven by the spirit of open source, we learn, build, and grow together. We're a community that turns ideas
          into impact through collaboration and code.
        </p>
        <Button variant="primary" class="w-fit text-xl text-white">Join Us</Button>
      </div>
      <img src="/assets/vectors/about-doscom-3.png" alt="doscom" class="w-1/3" />
    </div>
  </div>
</section>
