---
import Button from '../../ui/Button.astro'
import Card from '../../ui/Card.astro'

const teamValues = [
  {
    image: '/assets/photos/about-pemro-3.webp',
    title: 'Pemrograman',
    desc: 'Tempat di mana ide menjadi kode dan kolaborasi menjadi solusi.',
  },
  {
    image: '/assets/photos/about-jaringan-3.webp',
    title: 'Jaringan',
    desc: 'Menghubungkan dunia dengan teknologi dan inovasi.',
  },
  {
    image: '/assets/photos/about-data-3.webp',
    title: 'Data',
    desc: 'Mengelola informasi untuk keputusan yang lebih baik dan masa depan yang cerdas.',
  },
  {
    image: '/assets/photos/about-crevmed-3.webp',
    title: 'Creative Media',
    desc: 'Menggabungkan kreativitas dan teknologi untuk menciptakan konten yang menginspirasi.',
  },
]
---

<section class="flex min-h-screen justify-center overflow-hidden bg-white px-6 py-20 lg:px-10">
  <div class="flex w-full max-w-7xl flex-col gap-16 lg:gap-28">
    <div class="flex flex-col gap-8">
      <h2 class="text-4xl font-extrabold tracking-tight text-gray-900 md:text-5xl lg:text-6xl">Core Team Value</h2>

      <div
        id="scroll-container"
        class="no-scrollbar -mx-6 flex snap-x snap-mandatory overflow-x-auto px-6 pb-4 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 lg:grid-cols-4"
      >
        {
          teamValues.map((item, index) => (
            <div
              class={`min-w-[85%] snap-center sm:min-w-full ${index !== teamValues.length - 1 ? 'pr-4 sm:pr-0' : ''}`}
            >
              <Card variant="core-team" image={item.image} title={item.title} desc={item.desc} />
            </div>
          ))
        }
      </div>

      <div class="flex items-center gap-2 sm:hidden">
        <div id="indicator-bar" class="relative h-1 w-24 overflow-hidden rounded-full bg-gray-200">
          <div
            id="indicator-progress"
            class="absolute top-0 left-0 h-full w-1/4 bg-[#0A84DC] transition-all duration-150"
          >
          </div>
        </div>
        <span class="text-[10px] font-bold tracking-[0.2em] text-gray-400 uppercase">Swipe</span>
      </div>
    </div>

    <div class="flex flex-col-reverse items-center justify-between gap-12 lg:flex-row lg:gap-20">
      <div class="flex flex-col justify-center gap-6 text-center lg:w-2/3 lg:text-left">
        <h2 class="text-4xl leading-[0.95] font-black tracking-tighter text-gray-900 uppercase sm:text-6xl xl:text-7xl">
          Our Best Team
        </h2>
        <p class="max-w-2xl text-lg leading-relaxed font-light text-gray-600 sm:text-xl lg:text-2xl">
          Driven by the spirit of open source, we learn, build, and grow together. We're a community that turns ideas
          into impact through collaboration and code.
        </p>
        <div class="flex justify-center lg:justify-start">
          <Button
            variant="primary"
            class="w-fit rounded-full px-8 py-3.5 text-base font-bold text-white transition-transform hover:scale-105 active:scale-95 md:text-lg"
          >
            Join Us
          </Button>
        </div>
      </div>

      <div class="w-2/3 sm:w-1/2 lg:w-1/3">
        <img src="/assets/vectors/about-doscom-3.png" alt="doscom" class="h-auto w-full object-contain" />
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.getElementById('scroll-container')
  const progress = document.getElementById('indicator-progress')

  if (container && progress) {
    container.addEventListener('scroll', () => {
      const scrollPercentage = (container.scrollLeft / (container.scrollWidth - container.clientWidth)) * 100
      progress.style.left = `${Math.max(0, Math.min(scrollPercentage, 75))}%`
    })
  }
</script>
