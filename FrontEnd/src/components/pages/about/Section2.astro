---
import Button from "../../ui/Button.astro";
---

<section class="relative flex min-h-screen w-full items-center justify-center">
  <div class="relative z-10 flex max-w-7xl flex-col items-center gap-11 text-white">
    <div class="flex flex-col justify-center gap-2 text-center uppercase">
      <div class="flex flex-col">
        <p class="text-[24px] font-extralight">WE ARE MORE THAN JUST A COMMUNITY</p>
        <p class="text-[42px] font-light">DRIVEN BY OPEN SOURCE</p>
      </div>
      <p class="text-[106px] leading-tight font-bold">UNITED BY<br />COLLABORATION</p>
      <p class="text-[36px] font-light">We Learn. We Share. We Create Impact.</p>
    </div>
    <div class="flex gap-5 text-3xl">
      <Button variant="primary" class="text-white">Our Story</Button>
      <Button variant="outline" class="text-white">Who We Are?</Button>
    </div>
  </div>
  <img
    src="/assets/photos/about-2.webp"
    alt="foto doscom"
    class="absolute inset-0 max-h-screen w-full bg-red-100 object-cover"
  />
  <div class="absolute inset-0 min-h-screen bg-[#0E0E0E]/60"></div>
</section>
