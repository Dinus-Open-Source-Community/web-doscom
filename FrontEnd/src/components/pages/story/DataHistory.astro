---
interface Props {
	year?: string;
	description?: string;
}

const {
	year = '2025-Present',
	// Default description persis seperti requestmu
	description = `DOSCOM adalah komunitas open source di Universitas Dian Nuswantoro yang
      berfokus pada pengembangan, edukasi, dan kolaborasi dalam dunia teknologi
      terbuka. <br class="md:block hidden" />
      Kami percaya bahwa semangat open source bukan hanya tentang kode, tetapi juga
      tentang berbagi pengetahuan, membangun bersama, dan tumbuh sebagai satu komunitas.`,
} = Astro.props;
---

<div class="bg-white w-full h-full">
	<div class="py-6 max-w-7xl mx-auto px-4 md:px-6">
		<div
			class="flex flex-col-reverse md:flex-row py-6 font-jakarta w-full justify-between items-start md:items-center gap-6 md:gap-0"
		>
			<p
				class="text-xl text-[var(--text-secondary)] font-normal md:w-[463px] w-full tracking-tight"
			>
				<span set:html={description} />
			</p>
			<h1
				class="text-5xl font-bold tracking-tight justify-start md:justify-center items-center flex"
			>
				{year}
			</h1>
		</div>

		<div
			class="grid grid-cols-1 py-4 md:grid-cols-3 auto-rows-[minmax(100px,auto)] gap-4"
		>
			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center row-span-1 md:row-span-6 col-span-1"
			>
			</div>

			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center col-span-1 md:col-span-2 row-span-4"
			>
				<img
					src="/assets/image/fotbar-rp.jpg"
					alt="fotbar"
					class="rounded-2xl w-fit h-fit object-cover"
				/>
			</div>
			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center row-span-2"
			>
			</div>
			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center row-span-4"
			>
			</div>
			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center row-span-2"
			>
			</div>
			<div
				class="bg-[#D9D9D9] text-white rounded-2xl flex items-center justify-center row-span-2"
			>
			</div>
		</div>
	</div>
</div>
