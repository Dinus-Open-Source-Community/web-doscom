---
interface Props {
	years: string[]
	activeYear: string
}

const { years, activeYear } = Astro.props

function labelFor(year: string): string {
	const n = parseInt(year)
	const next = n + 1
	return `${next}/${year}`
}
---

<div class="bg-[var(--color-primary)] w-full">
	<div class="max-w-7xl mx-auto px-4 md:px-6">
		<nav class="flex flex-row overflow-x-auto items-center py-4 gap-6 md:gap-8 no-scrollbar mask-gradient">
			{
				years.map((y) => (
					<button
						data-year={y}
						class:list={[
							'tab-year whitespace-nowrap font-jakarta text-sm font-bold border-none pb-1 transition-all duration-300 ease-in-out md:text-base',
							y === activeYear
								? 'text-white font-bold cursor-default'
								: 'text-white/60 font-medium cursor-pointer hover:text-white',
						]}
					>
						{y === years[0] ? `Present - ${y}` : labelFor(y)}
					</button>
				))
			}
		</nav>
	</div>
</div>
