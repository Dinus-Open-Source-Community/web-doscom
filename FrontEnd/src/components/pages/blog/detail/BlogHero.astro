---
import type { Blog } from "@lib/types";

interface Props {
  blog?: Blog;
}

const { blog } = Astro.props as Props;

function formatDate(date?: string | null): string {
  if (!date) return "";
  try {
    return new Date(date).getFullYear().toString();
  } catch {
    return "";
  }
}
---

<section class="flex flex-col gap-8">
  <div
    class="flex flex-col items-start justify-between gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-end"
  >
    <h1
      class="text-4xl font-bold tracking-tight text-gray-900 md:text-5xl lg:text-6xl"
    >
      {blog?.title ?? "Blog"}
    </h1>
    <span class="text-lg font-medium text-gray-600 md:text-xl">
      {formatDate(blog?.published_at)}
    </span>
  </div>

  <div
    class="relative aspect-video w-full overflow-hidden rounded-3xl bg-gray-100 sm:aspect-21/9"
  >
    {blog?.thumbnail_url ? (
      <img
        src={blog.thumbnail_url}
        alt={blog.title}
        class="h-full w-full object-cover object-center"
      />
    ) : (
      <img
        src="/assets/photos/dummy-cover.webp"
        alt="Blog Cover"
        class="h-full w-full object-cover object-center"
      />
    )}
  </div>
</section>
