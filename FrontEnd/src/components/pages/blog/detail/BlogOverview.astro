---
import type { Blog } from "@lib/types";

interface Props {
  blog?: Blog;
}

const { blog } = Astro.props as Props;

const category = Array.isArray(blog?.kategori)
  ? blog.kategori.join(", ")
  : blog?.kategori ?? "";
---

<section class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8">
  <div class="flex flex-col gap-6 lg:col-span-5">
    <h2
      class="text-2xl leading-snug font-bold text-gray-900 sm:text-3xl lg:text-4xl"
    >
      {blog?.title ?? "Blog"}
    </h2>
    {category && (
      <span class="inline-block w-fit rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-600">
        {category}
      </span>
    )}
  </div>

  <div
    class="flex flex-col gap-6 text-base leading-relaxed text-gray-600 lg:col-span-7 lg:pl-12"
  >
    {blog?.content ? (
      <div set:html={blog.content} />
    ) : (
      <p class="italic text-gray-400">Tidak ada konten.</p>
    )}
  </div>
</section>
