---
interface Props {
  images?: string[];
}

const { images = [] } = Astro.props as Props;

const gallery = images.length >= 4 ? images.slice(0, 5) : [];
const count = gallery.length;
const fallback = [
  "/assets/photos/gallery-1.webp",
  "/assets/photos/gallery-2.webp",
  "/assets/photos/gallery-3.webp",
  "/assets/photos/gallery-4.webp",
  "/assets/photos/gallery-5.webp",
  "/assets/photos/gallery-6.webp",
];

function imgUrl(i: number): string {
  return i < gallery.length ? gallery[i] : fallback[i] ?? "";
}
---

<section class="flex flex-col gap-6">
  {count === 4 ? (
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
      <div class="col-span-2 row-span-2 aspect-square overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(0)} alt="Gallery 1" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(1)} alt="Gallery 2" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(2)} alt="Gallery 3" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-2 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-3 md:rounded-3xl">
        <img src={imgUrl(3)} alt="Gallery 4" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
    </div>
  ) : count === 5 ? (
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
      <div class="col-span-2 row-span-2 aspect-square overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(0)} alt="Gallery 1" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(1)} alt="Gallery 2" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(2)} alt="Gallery 3" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={imgUrl(3)} alt="Gallery 4" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-2 row-span-1 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:rounded-3xl">
        <img src={imgUrl(4)} alt="Gallery 5" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:grid-rows-3 md:gap-6">
      <div class="col-span-2 row-span-2 aspect-square overflow-hidden rounded-2xl bg-gray-100 md:aspect-auto md:rounded-3xl">
        <img src={fallback[0]} alt="Gallery 1" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-2 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:row-span-1 md:rounded-3xl">
        <img src={fallback[1]} alt="Gallery 2" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-2 aspect-video overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:row-span-1 md:rounded-3xl">
        <img src={fallback[2]} alt="Gallery 3" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 aspect-4/3 overflow-hidden rounded-2xl bg-gray-100 md:col-span-1 md:rounded-3xl">
        <img src={fallback[3]} alt="Gallery 4" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-1 aspect-4/3 overflow-hidden rounded-2xl bg-gray-100 md:col-span-1 md:rounded-3xl">
        <img src={fallback[4]} alt="Gallery 5" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
      <div class="col-span-2 aspect-21/9 overflow-hidden rounded-2xl bg-gray-100 md:col-span-2 md:aspect-auto md:rounded-3xl">
        <img src={fallback[5]} alt="Gallery 6" class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" />
      </div>
    </div>
  )}
</section>
