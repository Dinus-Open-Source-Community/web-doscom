---
import Card from "../../ui/Card.astro";
import type { BlogThumbnail } from "../../../lib/types";

interface Props {
  blogs: BlogThumbnail[];
  categories: string[];
  activeCategory: string;
  currentPage: number;
  totalPages: number;
  search: string;
}

const { blogs, categories, activeCategory, currentPage, totalPages, search } = Astro.props;

function generatePageNumbers(current: number, total: number): (number | "...")[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | "...")[] = [1];
  if (current > 3) pages.push("...");
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  for (let i = start; i <= end; i++) pages.push(i);
  if (current < total - 2) pages.push("...");
  if (total > 1) pages.push(total);
  return pages;
}

function parseTags(raw: string | string[]): string[] {
  if (Array.isArray(raw)) return raw;
  return raw
    .replace(/[\[\]{}()]/g, "")
    .split(",")
    .map((t) => t.trim())
    .filter(Boolean);
}
---

<section class="relative flex min-h-screen justify-center bg-white">
  <div class="my-12 flex w-full max-w-[96rem] flex-col gap-5">
    <form method="GET" class="flex w-full items-center justify-between gap-4">
      <div class="flex w-full max-w-md items-center gap-2">
        <input
          type="text"
          name="search"
          value={search}
          placeholder="Cari blog..."
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-(--color-primary)"
        />
        <button type="submit" class="rounded-lg bg-(--color-primary) px-4 py-2 text-sm text-white">
          Cari
        </button>
      </div>
      <select
        name="kategori"
        class="rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-(--color-primary)"
        onchange="this.form.submit()"
      >
        <option value="">Semua</option>
        {categories.map((c) => (
          <option value={c} selected={activeCategory === c}>{c}</option>
        ))}
      </select>
    </form>
    <div class="flex flex-col items-center gap-3">
      <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {blogs.length > 0 ? (
          blogs.map((blog, index) => (
            <a href={"/blog/" + blog.id} class="block">
              <Card
                variant="blogs"
                title={blog.title}
                tags={parseTags(blog.kategori)}
                index={index}
                image={blog.thumbnail_url}
              />
            </a>
          ))
        ) : (
          <p class="col-span-full py-12 text-center text-gray-500">Tidak ada blog yang ditemukan.</p>
        )}
      </div>

      {totalPages > 1 && (
        <div class="flex items-center justify-center gap-1">
          {currentPage > 1 && (
            <a
              href={`?search=${search}${activeCategory ? `&kategori=${activeCategory}` : ""}&page=${currentPage - 1}`}
              class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition-all duration-200 hover:border-(--color-primary) hover:text-(--color-primary)"
              aria-label="Previous page"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </a>
          )}
          {generatePageNumbers(currentPage, totalPages).map((p) =>
            p === "..." ? (
              <span class="flex h-9 w-9 items-center justify-center text-sm text-gray-400">...</span>
            ) : (
              <a
                href={`?search=${search}${activeCategory ? `&kategori=${activeCategory}` : ""}&page=${p}`}
                class={`flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium transition-all duration-200 ${
                  p === currentPage
                    ? "bg-(--color-primary) text-white shadow-sm ring-1 ring-(--color-primary)/30"
                    : "border border-gray-200 bg-white text-gray-500 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-700"
                }`}
              >
                {p}
              </a>
            )
          )}
          {currentPage < totalPages && (
            <a
              href={`?search=${search}${activeCategory ? `&kategori=${activeCategory}` : ""}&page=${currentPage + 1}`}
              class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition-all duration-200 hover:border-(--color-primary) hover:text-(--color-primary)"
              aria-label="Next page"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
