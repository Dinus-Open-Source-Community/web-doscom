---

<section class="relative w-full h-full font-jakarta overflow-hidden bg-white ">
  <img 
    src="/assets/vectors/division-right.svg" 
    alt="decoration" 
    class="absolute -top-23 right-0 z-0 pointer-events-none select-none"
  />
  
  <img 
    src="/assets/vectors/division-left.svg" 
    alt="decoration" 
    class="absolute -bottom-275 left-0 z-0 pointer-events-none select-none" 
  />
  

  <div class="relative z-10 w-full px-38 pt-8 pb-17">
    <div class="w-full max-w-[670px]">
      <h1 class="font-semibold text-3xl md:text-5xl mb-2 text-gray-900">Our Team</h1>
      <p class="text-[8px] md:text-lg tracking-normal text-gray-700">
        A list of planned activities that will be implemented to achieve organizational goals in a structured and sustainable manner.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 mt-8">
      
      {teamMembers.map((member) => (
        <div class="flex flex-col">  
            <img 
              src={member.image} 
              alt={`Foto ${member.name}`} 
              class="w-[270px] h-[318px] object-cover rounded-2xl"
              loading="lazy"
            />
          <div class="mt-1">
            <h3 class="font-semibold text-[22px]">
              {member.name}
            </h3>
            <p class="text-lg leading-3 font-normal text-[#5F5F5F] ">
              {member.role}
            </p>
          </div>
        </div>
      ))}
    </div>
    </div>

</section>