---
interface Props {
	title: string;
	description: string;
	backgroundImage: string;
}

const { title, description, backgroundImage } = Astro.props;
---

<div class="relative w-full min-h-[50vh] flex items-end">
	<img
		src={backgroundImage}
		alt={title}
		class="absolute w-full h-full object-cover"
	/>
	<div class="absolute inset-0 bg-black/50"></div>
	<div class="absolute px-6 md:px-12 lg:px-70 pb-10 font-jakarta text-white">
		<h1
			class="font-bold tracking-tighter leading-[1]
                   text-4xl sm:text-6xl md:text-7xl lg:text-8xl md:w-[670px] w-full"
		>
			{title}
		</h1>

		<p
			class="font-normal mt-3
                  text-base sm:text-lg md:text-xl leading-snug md:w-[670px] w-full"
		>
			{description}2
		</p>
	</div>
</div>
