---
import Modal from '@components/ui/admin/Modal.astro'
import ButtonAdmin from '@components/ui/ButtonAdmin.astro'
---

<Modal
  id="change-password-modal"
  title="Change Password"
  description="Set a new password for this administrator account."
  size="sm"
>
  <form id="form-change-password" class="flex flex-col gap-4">
    {/* Hidden Input untuk menyimpan ID Admin yang akan diubah password-nya */}
    <input type="hidden" name="target_id" class="target-id-input" />

    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-medium text-gray-700">New Password</label>
      <input
        type="password"
        name="new_password"
        id="new_password"
        required
        minlength="8"
        placeholder="At least 8 characters"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-medium text-gray-700"
        >Confirm New Password</label
      >
      <input
        type="password"
        name="confirm_password"
        id="confirm_password"
        required
        minlength="8"
        placeholder="Repeat new password"
        class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 text-sm transition-all outline-none focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
      />
      <p id="password-error" class="mt-1 hidden text-xs text-rose-500">
        Passwords do not match.
      </p>
    </div>

    <div
      class="mt-4 flex w-full items-center justify-end gap-3 border-t border-gray-100 pt-5"
    >
      <ButtonAdmin
        type="button"
        variant="admin-outline"
        onclick="window.closeModal('change-password-modal')"
        class="w-full sm:w-auto"
      >
        Cancel
      </ButtonAdmin>
      <ButtonAdmin
        type="submit"
        variant="admin-primary"
        class="w-full sm:w-auto"
      >
        Update Password
      </ButtonAdmin>
    </div>
  </form>
</Modal>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- FUNGSI GLOBAL PEMBUKA MODAL ---
    if (typeof (window as any).openChangePasswordModal === 'undefined') {
      ;(window as any).openChangePasswordModal = (adminId: string) => {
        if (!adminId) return

        const pwdForm = document.getElementById('form-change-password')
        if (pwdForm) {
          const idInput = pwdForm.querySelector(
            '.target-id-input'
          ) as HTMLInputElement
          if (idInput) idInput.value = adminId
        }

        // Reset error message & form values setiap kali dibuka
        const errorMsg = document.getElementById('password-error')
        if (errorMsg) errorMsg.classList.add('hidden')
        ;(window as any).openModal('change-password-modal')
      }
    }

    // --- LOGIKA SUBMIT (Ganti Password API) ---
    const pwdForm = document.getElementById(
      'form-change-password'
    ) as HTMLFormElement

    if (pwdForm && pwdForm.dataset.listenerAttached !== 'true') {
      pwdForm.dataset.listenerAttached = 'true'

      pwdForm.addEventListener('submit', async e => {
        e.preventDefault()

        const newPwd = (
          document.getElementById('new_password') as HTMLInputElement
        ).value
        const confirmPwd = (
          document.getElementById('confirm_password') as HTMLInputElement
        ).value
        const errorMsg = document.getElementById('password-error')

        // Validasi Frontend: Pastikan password cocok
        if (newPwd !== confirmPwd) {
          if (errorMsg) errorMsg.classList.remove('hidden')
          return
        } else {
          if (errorMsg) errorMsg.classList.add('hidden')
        }

        const submitBtn = pwdForm.querySelector(
          'button[type="submit"]'
        ) as HTMLButtonElement
        const originalText = submitBtn.innerText
        submitBtn.innerText = 'Updating...'
        submitBtn.disabled = true

        const formData = new FormData(pwdForm)
        const targetId = formData.get('target_id')

        // Buat payload JSON
        const payload = {
          password: newPwd,
        }

        try {
          // Asumsi endpoint update password: /v1/superadmin/{id}/password
          // Sesuaikan dengan endpoint asli backend-mu jika berbeda
          const response = await fetch(
            `https://api.doscom.id/v1/superadmin/${targetId}/password`,
            {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload),
            }
          )

          const result = await response.json()

          if (response.status === 200 && result.success) {
            ;(window as any).closeModal('change-password-modal')
            ;(window as any).showToast(
              'Password updated successfully!',
              'success'
            )
          } else {
            ;(window as any).showToast(
              result.message || 'Failed to update password',
              'error'
            )
          }
        } catch (error) {
          console.error('Network Error:', error)
          ;(window as any).showToast(
            'Network error, please try again.',
            'error'
          )
        } finally {
          submitBtn.innerText = originalText
          submitBtn.disabled = false
        }
      })
    }
  })
</script>
