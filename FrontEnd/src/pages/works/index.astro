---
import PublicLayout from "@layouts/PublicLayout.astro";
import Section2 from "@components/pages/works/Section2.astro";
import Section3 from "@components/pages/works/Section3.astro";
import HeaderDivision from "@components/pages/division/HeaderDivision.astro";
import { workService } from "@services/work.service";
import type { WorkPublic } from "@lib/types";

const type = Astro.url.searchParams.get('type') ?? ''
const search = Astro.url.searchParams.get('search') ?? ''
const page = Number(Astro.url.searchParams.get('page')) || 1
const limit = 9

let works: WorkPublic[] = []
let totalPages = 1
let types: string[] = []
try {
  types = await workService.getTypes()
  const query: Record<string, string | number> = { page, limit }
  if (type) query.projecttype = type
  if (search) query.search = search
  const worksResponse = await workService.list(query)
  works = worksResponse["work data"] ?? worksResponse.worksData ?? []
  totalPages = worksResponse.totalPages ?? worksResponse.totalPage ?? 1
} catch (e) {
  // defaults remain
}
---

<PublicLayout title="Works">
  <HeaderDivision
    title="Our Works"
    description=" tim yang bertanggung jawab untuk menghasilkan konten-konten kreatif dan menarik secara visual maupun audio untuk
              berbagai platform, seperti media sosial, website, dan media lainnya"
    backgroundImage="/assets/photos/header-division.jpg"
  />
  <Section2 {works} {types} activeType={type} currentPage={page} {totalPages} {search} />
  <Section3 />
</PublicLayout>
