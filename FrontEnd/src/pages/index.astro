---
import PublicLayout from '../layouts/PublicLayout.astro'
import VisiMisi from '../components/VisiMisi.astro'
import CreateImpact from '../components/CreateImpact.astro'
import Home from '../components/Home.astro'
import OurPrograms from '../components/OurPrograms.astro'
import OurWorks from '../components/OurWorks.astro'
import OurActivities from '../components/OurActivities.astro'
import { workService } from '../services/work.service'

interface WorkItem {
	image_url: string
	title: string
	description: string
	project_type: string
	slug: string
}

let works: WorkItem[] = []
try {
	const worksResponse = await workService.list()
	works = (worksResponse["work data"] ?? worksResponse.worksData ?? []) as WorkItem[]
} catch {}
---

<PublicLayout title="Home">
  <section class="w-full bg-white">
    <Home />
    <OurPrograms items={works} />
    <div class="mt-12 h-full w-full bg-(--color-primary)">
      <VisiMisi />
    </div>
    <OurWorks items={works} />
    <OurActivities items={works} />
    <CreateImpact />
  </section>
</PublicLayout>
