---
import PublicLayout from '../layouts/PublicLayout.astro'
import Button from '../components/ui/Button.astro'
import ArrowLeft from '/public/assets/icons/arrowleft.svg'
import ArrowRight from '../../public/assets/icons/arrowright.svg'
import ArrowRightPrimary from '../../public/assets/icons/arrowRightPrimary.svg'
import ArrowLeftPrimary from '../../public/assets/icons/arrowLeftPrimary.svg'
import Card from '../components/ui/Card.astro'
import VisiMisi from '../components/VisiMisi.astro'
---

<PublicLayout title="Home">
    <section class="w-full">
        <div class="w-full h-screen">
            <img src="../../public/home.jpg" alt="Image-Doscom" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-black/60"></div>
            <div class="absolute inset-0 flex flex-col justify-between px-6 md:px-12 lg:px-42 py-26">
                <div class="mt-10 md:mt-24 lg:mt-32">
                    <h1 class="text-white font-bold font-jakarta tracking-tighter leading-[0.9]
            text-[48px] sm:text-[64px] md:text-[80px] lg:text-[100px]">
                        DINUS<br />OPEN<br />SOURCE<br />COMMUNITY
                    </h1>
                </div>

                <div class="flex flex-col items-end gap-4 mb-6 md:mb-12 lg:mb-16">
                    <p class="text-white font-normal font-jakarta leading-tight tracking-tight text-end
          text-[24px] sm:text-[32px] md:text-[40px] lg:text-[42px]">
                        Open Your Mind<br />With Open Source
                    </p>

                    <div class="flex flex-row gap-3">
                        <Button variant="primary" size="default" class="font-medium text-white text-2xl"> About </Button>
                        <Button variant="outline" size="large" class="text-white font-medium text-2xl"> Contribute </Button>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl w-full h-full mx-auto mt-10 sm:p-4 p-0">
            <div class="w-full">
                <h1 class="font-semibold text-5xl font-jakarta">Our Programs</h1>
            </div>
            <div class="flex flex-row justify-between mt-4 mb-3">
                <p class="text-[var(--text-secondary)] font-normal text-lg font-jakarta">
                    A list of planned activities that will be implemented to <br /> achieve organizational goals in a structured and <br /> sustainable manner.
                </p>
                <div>
                    <Button variant="primary" size="icon"><ArrowLeft width={26} height={26} /> </Button>
                    <Button variant="primary" size="icon"><ArrowRight width={26} height={26} /></Button>
                </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-1 lg:grid-cols-3 gap-6">
                <Card
                    image="../../public/realeaseParty.jpg"
                    title="Release Party"
                    desc="Release Party adalah momen istimewa di mana Doscom secara resmi meluncurkan TeaLinuxOS, sebuah distro Linux berbasis open source yang dikembangkan secara mandiri oleh Doscom (Dinus Open Source Community)"
                    titleButton="Look Now"
                    variant="programs"
                />
                <Card
                    image="../../public/oots.jpg"
                    title="Open Source On The School"
                    desc="Open Source on The School adalah program berbagi ilmu dan inspirasi untuk siswa tingkat sekolah. Di sini, peserta diperkenalkan pada dunia open source, pemrograman dasar, dan pentingnya kolaborasi dalam teknologi."
                    titleButton="Look Now"
                    variant="programs"
                />
                <Card
                    image="../../public/du.jpg"
                    title="Doscom University"
                    desc="Doscom University adalah sebuah program pelatihan atau event yang diselenggarakan oleh Doscom (Dinus Open Source Community), sebuah komunitas open source di bawah naungan Univeristas Dian Nuswantoro. "
                    titleButton="Look Now"
                    variant="programs"
                />
            </div>
        </div>

        <div class="w-full mt-12 h-full bg-[var(--color-primary)]">
            <VisiMisi />
        </div>

        <div class="w-full">
            <div class="w-full max-w-7xl h-full mx-auto mt-10 md:px-0 px-4">
                <div class="w-full">
                    <h1 class="font-semibold text-5xl font-jakarta">Our Works</h1>
                </div>
                <div class="flex flex-row justify-between mt-4 mb-3">
                    <p class="text-[var(--text-secondary)] font-normal text-lg font-jakarta">
                        A list of planned activities that will be implemented to <br /> achieve organizational goals in a structured and <br /> sustainable manner.
                    </p>
                    <div>
                        <Button variant="primary" size="icon"><ArrowLeft width={26} height={26} /> </Button>
                        <Button variant="primary" size="icon"><ArrowRight width={26} height={26} /></Button>
                    </div>
                </div>
            </div>

            <div class="flex gap-6 overflow-x-auto relative w-full py-3 overflow-visible no-scrollbar px-10 snap-x no-scrollbar scroll-smooth">
                <Card
                    image="../../public/Dform.png"
                    variant="works"
                    title="TealinuxOS"
                    desc="A digital platform for community event attendance and registration"
                    category="Operation System"
                />
                <Card
                    image="../../public/tealinux.png"
                    variant="works"
                    title="TealinuxOS"
                    desc="A Linux-based operating system with a lightweight and user-friendly interface."
                    category="Operation System"
                />
                <Card
                    image="../../public/Dform.png"
                    variant="works"
                    title="Rice Source"
                    desc="An open-source repository for community projects and experiments"
                    category="Open Source"
                />
            </div>
        </div>

        <div class="bg-[var(--color-primary)] w-full h-full">
            <div class="w-full h-full py-12 flex pl-60">
                <div class="flex flex-col w-3xl justify-between space-y-6 py-3">
                    <div class="space-y-6">
                        <h1 class="font-jakarta font-semibold text-5xl tracking-tight text-white">Our Recent <br /> Activities</h1>
                        <ul class="font-jakarta font-normal tracking-tight text-white text-3xl leading-relaxed">
                            <li>Daily Activity</li>
                            <li>Works</li>
                            <li>Events</li>
                            <li>Sharing</li>
                        </ul>
                    </div>
                    <div>
                        <Button variant="secondary" size="icon"><ArrowLeftPrimary width={26} height={26} /> </Button>
                        <Button variant="secondary" size="icon"><ArrowRightPrimary width={26} height={26} /></Button>
                    </div>
                </div>

                <div class="flex gap-6 overflow-x-auto relative w-full py-3 overflow-visible no-scrollbar snap-x no-scrollbar scroll-smooth">
                    <Card
                        image="../../public/realeaseParty.jpg"
                        variant="activities"
                        title="TealinuxOS"
                        desc="Release Party adalah acara peluncuran TeaLinuxOS, distro Linux racikan DOSCOM yang dikembangkan secara terbuka dengan filosofi “Nikmatnya Sebuah Racikan”."
                        category={['Workshop', 'Bootcamp']}
                    />
                    <Card
                        image="../../public/realeaseParty.jpg"
                        variant="activities"
                        title="Doscom University"
                        desc="Doscom University bukanlah universitas fisik, melainkan sebuah program atau acara pelatihan yang diselenggarakan oleh Doscom (Dinus Open Source Community). "
                        category={['Workshop', 'Bootcamp']}
                    />
                    <Card
                        image="../../public/realeaseParty.jpg"
                        variant="activities"
                        title="Rice Source"
                        desc="An open-source repository for community projects and experiments"
                        category={['Workshop', 'Bootcamp']}
                    />
                </div>
            </div>
        </div>

        <div class="relative w-full h-[380px] sm:h-[460px] md:h-[520px] lg:h-[580px] xl:h-[714px] overflow-hidden">
            <img src="../../public/createImpact.jpg" alt="Create Impact" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />

            <div class="absolute inset-0 bg-black/60"></div>

            <h1
                class="absolute inset-0 flex items-center w-[483px] left-20 px-6 text-white font-jakarta font-bold leading-tight tracking-tight text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl"
            >
                Your open source spirit is our mission. Together, we #CreateImpact.
            </h1>
        </div>
    </section>
</PublicLayout>
