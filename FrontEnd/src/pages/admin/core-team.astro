---
import { Search } from '../../assets/icons'
import { Plus, Download, Filter } from '../../assets/icons'
import { ButtonAdmin, Pagination } from '../../components'
import Table from '../../components/ui/Table.astro'
import AdminLayout from '../../layouts/AdminLayout.astro'

const headers = ['ID', 'Member', 'Join Date', 'Status', 'Actions']

// ini get data json
const coreTeamData = [
  {
    id: 'CT-0001',
    name: 'Husnul Fikri Averus',
    email: '111202412345@mhs.dinus.ac.id',
    avatar: '/assets/photos/about-pemro-3.webp',
    date: 'March 12, 2026',
    status: 'Completed',
  },
  {
    id: 'CT-0002',
    name: 'Thomas Aero',
    email: 'aerthomo@gmail.com',
    avatar: '/assets/photos/about-jaringan-3.webp',
    date: 'March 13, 2026',
    status: 'Completed',
  },
  {
    id: 'CT-0003',
    name: 'David Kemp',
    email: 'david99dav@gmail.com',
    avatar: '/assets/photos/about-data-3.webp',
    date: 'March 15, 2026',
    status: 'Refunded',
  },
  {
    id: 'CT-0004',
    name: 'Mary Richards',
    email: 'maryricha@gmail.com',
    avatar: '/assets/photos/about-crevmed-3.webp',
    date: 'March 18, 2026',
    status: 'Canceled',
  },
]
---

<AdminLayout title="Core Team Management">
  <div class="flex w-full flex-col gap-8 bg-gray-50/30 p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900 select-none">Core Team</h1>
        <p class="mt-1 text-xs text-gray-400 select-none">Last update a minutes ago</p>
      </div>
      <div class="flex items-center gap-3">
        <ButtonAdmin variant="admin-outline" size="small" class="font-bold select-none">
          <span class="h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Download} />
          Download
        </ButtonAdmin>

        <ButtonAdmin variant="admin-primary" size="small" class="font-bold select-none">
          <span class="h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Plus} />
          Add Member
        </ButtonAdmin>
      </div>
    </div>

    <div class="flex flex-col gap-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div class="relative w-full sm:max-w-xs">
          <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
            <span class="h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Search} />
          </span>
          <input
            type="text"
            placeholder="Search Member..."
            class="w-full cursor-default rounded-xl border border-gray-200 bg-gray-50/50 py-2.5 pr-4 pl-11 text-sm transition-all outline-none placeholder:text-gray-400 focus:border-gray-900 focus:bg-white focus:ring-1 focus:ring-gray-900"
          />
        </div>

        <div class="flex items-center gap-2 self-end sm:self-auto">
          <ButtonAdmin
            variant="admin-outline"
            size="icon"
            class="rounded-xl p-2.5 text-gray-500 hover:border-gray-300 hover:bg-gray-100/70 hover:text-gray-900"
          >
            <span class="h-4 w-4 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={Filter} />
          </ButtonAdmin>
        </div>
      </div>

      <Table headers={headers} data={coreTeamData} />

      <Pagination variant="datatable" currentPage={1} totalPages={12} startEntry={1} endEntry={4} totalEntries={24} />
    </div>
  </div>
</AdminLayout>
