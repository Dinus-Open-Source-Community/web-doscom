---
import AuthLayout from '../../layouts/AuthLayout.astro'
import Logo from '../../assets/logo-doscom.svg?raw'
import Input from '../../components/ui/Input.astro'
import Button from '../../components/ui/Button.astro'
---

<AuthLayout title="Dashboard">
  <main
    class="font-jakarta relative flex min-h-dvh items-center justify-between px-10 md:max-h-screen md:min-h-screen md:px-20 md:py-32"
  >
    <!-- sisi kiri -->
    <div class="z-10 flex h-fit justify-center md:w-1/2">
      <div
        class="flex flex-col gap-6 rounded-xl py-6 md:px-5 lg:w-[92%] lg:px-10 2xl:w-[65%]"
      >
        <!-- header -->
        <div class="flex flex-col gap-2">
          <p
            class="text-center text-2xl font-semibold text-white md:text-left lg:text-3xl xl:text-4xl"
          >
            Login to Your Account
          </p>
          <p
            class="text-center text-sm font-normal text-white/70 md:text-left md:text-sm"
          >
            "Memasyarakatkan Open Source dan Meng-Open Source-kan Masyrakat"
          </p>
        </div>

        <!-- form -->
        <div class="flex flex-col gap-3 text-white">
          <div class="flex flex-col gap-2">
            <p class="">Email</p>
            <Input
              variant="admin"
              class="bg-black/20 text-white placeholder:text-white/70"
              placeholder="111202312345@mhs.dinus.ac.id"
            />
          </div>
          <div class="flex flex-col gap-2">
            <p class="">Password</p>
            <Input
              variant="admin"
              type="password"
              class="bg-black/20 text-white placeholder:text-white/70"
              placeholder="••••••••"
            />
          </div>
        </div>
        <Button
          set:text="Authenticate"
          class="rounded-2xl bg-white font-semibold text-[#0a84dc] hover:bg-white/95"
        />

        <!-- lainnya -->
        <p class="text-xs text-white/50 italic">
          (mungkin nanti juga punya opsi lain untuk login)
        </p>
      </div>
    </div>

    <!-- sisi kanan -->
    <div class="absolute right-10 bottom-10 z-10 w-50">
      <span class="text-white [&>svg]:h-full [&>svg]:w-full" set:html={Logo} />
    </div>

    <!-- dash image -->
    <img
      src="/assets/image/login/dash-login.webp"
      alt="dash"
      class="pointer-events-none absolute right-1/3 z-10 hidden h-full translate-x-1/2 object-cover select-none md:block"
    />

    <!-- texture pattern -->
    <img
      src="/assets/image/login/bg-login.webp"
      alt="background login"
      class="pointer-events-none absolute right-0 bottom-0 -z-10 h-full w-full object-cover opacity-70 select-none"
    />

    <!-- gradient overlay -->
    <div
      class="absolute left-0 min-h-dvh w-full bg-linear-to-tr from-(--color-primary) from-10% to-blue-400/0 md:min-h-screen md:from-40%"
    >
    </div>
  </main>
</AuthLayout>
