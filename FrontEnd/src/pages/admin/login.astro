---
import AuthLayout from "../../layouts/AuthLayout.astro";
import Logo from "../../assets/logo-doscom.svg?raw";
import Input from "../../components/ui/Input.astro";
import Button from "../../components/ui/Button.astro";
---

<AuthLayout title="Dashboard">
  <main
    class="min-h-dvh md:min-h-screen md:max-h-screen flex px-10 md:px-20 md:py-32 justify-between items-center relative"
  >
    <!-- sisi kiri -->
    <div class="flex md:w-1/2 justify-center h-fit z-10">
      <div class="flex flex-col md:px-5 lg:px-10 py-6 rounded-xl gap-6 lg:w-[92%] 2xl:w-[65%]">
        <!-- header -->
        <div class="flex flex-col gap-2">
          <p class="text-2xl text-center md:text-left lg:text-3xl xl:text-4xl font-semibold text-white">
            Login to Your Account
          </p>
          <p class="text-sm text-center md:text-left md:text-sm font-normal text-white/70">
            "Memasyarakatkan Open Source dan Meng-Open Source-kan Masyrakat"
          </p>
        </div>

        <!-- form -->
        <div class="flex flex-col gap-3 text-white">
          <div class="flex flex-col gap-2">
            <p class="">Email</p>
            <Input
              variant="admin"
              class="bg-black/20 text-white placeholder:text-white/70"
              placeholder="111202312345@mhs.dinus.ac.id"
            />
          </div>
          <div class="flex flex-col gap-2">
            <p class="">Password</p>
            <Input
              variant="admin"
              type="password"
              class="bg-black/20 text-white placeholder:text-white/70"
              placeholder="••••••••"
            />
          </div>
        </div>
        <Button set:text="Authenticate" class="text-[#0a84dc] bg-white font-semibold rounded-2xl hover:bg-white/95" />

        <!-- lainnya -->
        <p class="text-white/50 text-xs italic">(mungkin nanti juga punya opsi lain untuk login)</p>
      </div>
    </div>

    <!-- sisi kanan -->
    <div class="absolute bottom-10 right-10 z-10 w-50">
      <span class="text-white [&>svg]:h-full [&>svg]:w-full" set:html={Logo} />
    </div>

    <!-- dash image -->
    <img
      src="/assets/image/login/dash-login.webp"
      alt="dash"
      class="absolute z-10 h-full right-1/3 translate-x-1/2 object-cover pointer-events-none select-none hidden md:block"
    />

    <!-- texture pattern -->
    <img
      src="/assets/image/login/bg-login.webp"
      alt="background login"
      class="absolute bottom-0 right-0 w-full h-full object-cover -z-10 opacity-70 pointer-events-none select-none"
    />

    <!-- gradient overlay -->
    <div
      class="absolute from-[var(--color-primary)] to-blue-400/0 from-10% md:from-40% min-h-dvh md:min-h-screen w-full left-0 bg-gradient-to-tr"
    >
    </div>
  </main>
</AuthLayout>
