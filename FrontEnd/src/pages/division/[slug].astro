---
import HeaderDivision from '../../components/pages/division/HeaderDivision.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Section1 from '../../components/pages/division/slug/Section1.astro';
import Section2 from '../../components/pages/division/slug/Section2.astro';
import { pengurusService } from '../../services/pengurus.service';
import type { PengurusPublic } from '../../lib/types';

interface Division {
	slug: string;
	name: string;
	description: string;
}

export async function getStaticPaths() {
  const mockDivisions: Division[] = [
    { slug: 'bph', name: 'Division Badan Pengurus Harian', description: 'Manajemen organisasi dan koordinasi antar divisi.' },
    { slug: 'pemro', name: 'Division Pemrograman', description: 'Pengembangan perangkat lunak dan pemrograman.' },
    { slug: 'jaringan', name: 'Division Jaringan', description: 'Manajemen jaringan dan infrastruktur komputer.' },
    { slug: 'medcrev', name: 'Division Media Creative', description: 'tim yang bertanggung jawab untuk menghasilkan konten-konten kreatif dan menarik secara visual maupun audio untuk berbagai platform.' },
    { slug: 'data', name: 'Division Data', description: 'Pengumpulan, pengolahan, dan analisis data.' },
  ];

  return mockDivisions.map((div) => ({
    params: { slug: div.slug },
    props: { divisionData: div },
  }));
}


const { divisionData } = Astro.props;

let members: PengurusPublic[] = [];
try {
  members = await pengurusService.listByDivision(divisionData.slug);
} catch {}
---

<PublicLayout title={divisionData.name}>
  <section class="bg-white">
     <HeaderDivision
      title={divisionData.name}
      description={divisionData.description}
      backgroundImage="/assets/photos/header-division.jpg"
    />
    <Section1 members={members} />
    <Section2/>
  </section>
</PublicLayout>