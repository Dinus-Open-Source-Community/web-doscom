---
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/layouts/Sidebar.astro'
import SearchModal from '../components/ui/admin/SearchModal.astro'
import { Toast } from '../components'

const { title } = Astro.props
---

<BaseLayout title="Admin Panel">
  <main class="font-jakarta flex h-screen overflow-hidden bg-gray-50">
    <SearchModal />
    <Sidebar />

    <div class="relative flex min-h-screen flex-1 flex-col overflow-hidden">
      <div class="flex-1 overflow-y-auto p-6">
        <slot />
      </div>

      <Toast />
    </div>
  </main>
</BaseLayout>
