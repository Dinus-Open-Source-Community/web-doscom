---
import BaseLayout from './BaseLayout.astro'
import StickyNavbar from '../components/layouts/StickyNavbar.astro'
import HeroNavbar from '../components/layouts/HeroNavbar.astro'
import Footer from '../components/layouts/Footer.astro'

const { title } = Astro.props
---

<BaseLayout title={title}>
  <div class="flex min-h-screen flex-col">
    <StickyNavbar />

    <main class="font-jakarta relative z-10 flex-1 bg-white">
      <HeroNavbar />
      <slot />
    </main>

    <div class="sticky bottom-0 z-0">
      <Footer />
    </div>
  </div>
</BaseLayout>
