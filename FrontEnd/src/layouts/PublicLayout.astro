---
import '../styles/global.css'
import Navbar from '../components/layouts/Navbar.astro'
// import Navbar from "../components/Navbar.astro";
import HeroNavbar from '../components/layouts/HeroNavbar.astro'
import StickyNavbar from '../components/layouts/StickyNavbar.astro'
import Footer from '../components/layouts/Footer.astro'

const { title } = Astro.props
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100..900&family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>Doscom | {title}</title>
    </head>
    <body class="flex min-h-screen flex-col">
        <StickyNavbar />

        <main class="relative z-10">
            <HeroNavbar />
            <slot />
        </main>
    </body>

    <div class="bottom-0 z-0">
        <Footer />
    </div>
</html>
