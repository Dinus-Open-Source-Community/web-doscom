---
import BaseLayout from './BaseLayout.astro'
import StickyNavbar from '../components/layouts/StickyNavbar.astro'
import HeroNavbar from '../components/layouts/HeroNavbar.tsx'
import Footer from '../components/layouts/Footer.astro'
import LogoRaw from '../assets/logo-doscom.svg?raw'

const { title } = Astro.props
const currentPath = Astro.url.pathname
---

<BaseLayout title={title}>
  <div class="flex min-h-screen flex-col">
    <StickyNavbar />

    <main class="font-jakarta relative z-10 flex-1 bg-white">
      <HeroNavbar logoHtml={LogoRaw} currentPath={currentPath} client:load />
      <slot />
    </main>

    <div class="sticky bottom-0 z-0">
      <Footer />
    </div>
  </div>
</BaseLayout>
